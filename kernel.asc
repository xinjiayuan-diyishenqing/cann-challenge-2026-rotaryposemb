// The Short gate bounds theta to[2^-32,2^32], halfDim to8..16.
// Retain the original compensated FP32 products and rounding order while
// reusing the unchanged right operand's Dekker split through the Horner chain.
__aicore__ inline SF ShortMulFixed(SF a,SF b,float bh,float bl){
 float h=SR(a.h*b.h),ca=SR(4097.0f*a.h);
 float ah=SR(ca-SR(ca-a.h)),al=SR(a.h-ah);
 float t=SR(SR(ah*bh)-h);t=SR(t+SR(ah*bl));
 t=SR(t+SR(al*bh));t=SR(t+SR(al*bl));
 t=SR(t+SR(a.h*b.l));t=SR(t+SR(a.l*b.h));
 float r=SR(h+t);return {r,SR(t-SR(r-h))};
}
// For all five retained exp-Horner stages |a.h|<|b.h| (|rr|<0.174).
// FastTwoSum forms the same exact high-sum error; low-tail addition and
// final normalization keep their original FP32 order.
__aicore__ inline SF ShortAddDominant(SF a,SF b){
 float h=SR(a.h+b.h),t=SR(a.h-SR(h-b.h));
 t=SR(t+SR(a.l+b.l));float r=SR(h+t);
 return {r,SR(t-SR(r-h))};
}
__aicore__ inline SF ShortNormalize(float h,float l){
 float r=SR(h+l);return {r,SR(l-SR(r-h))};
}
// Each bit belongs to the dimension index, not to a stored frequency.
// Every selected lane multiplies the current-call floating base on the NPU.
template<int Bit,bool NeedSquare> __aicore__ inline void ShortLadderStage(
 LocalTensor<float> inv,LocalTensor<float> base,int n){
 constexpr uint64_t indexBits=~(~0ULL/((1ULL<<(1u<<Bit))+1ULL));
 const uint64_t lanes=n==8?0xffULL:0xffffULL;
 SetMaskNorm();SetVectorMask<float,MaskMode::NORMAL>(0,indexBits&lanes);
 FMul(inv,inv,base,n);PipeBarrier<PIPE_V>();
 SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(0,n);
 if constexpr(NeedSquare){FMul(base,base,base,n);PipeBarrier<PIPE_V>();}
}

// Short axes build every inverse frequency from one scalar double-float ratio
// b = theta^(-1/halfDim) and a masked product ladder b^(2^k); all floating
// work stays on the NPU and is recomputed each invocation.
__aicore__ inline void MakeInvShort(LocalTensor<float> inv,LocalTensor<float> w,int halfDim,float theta){
 const int n=(halfDim+7)/8*8;
 float logh,logl;LogPair(theta,logh,logl);
 SF t;
 if((halfDim&(halfDim-1))==0){
  // Division by8/16 is an exact binary exponent shift in this bounded
  // domain. Normalize the two scaled components instead of recomputing
  // a full compensated product/residual for the same exact quotient.
  t=ShortNormalize(SR(-logh/(float)halfDim),SR(-logl/(float)halfDim));
 }else t=SDiv({-logh,-logl},{(float)halfDim,0.0f});
 // Half-width reduction keeps |rr| <= ln2/4 so a degree-5 relative minimax suffices;
 // every coefficient and the sqrt(2) tail stay in compensated FP32 form.
 const float invHalfLn2=2.8853900817779268f;
 float q=t.h*invHalfLn2;
 int ei=(int)(q+(q>=0.0f?0.5f:-0.5f));
 SF rr=SAdd(t,SMul({(float)ei,0.0f},{-0.3465735912322998046875f,9.523271615741181e-10f}));
 const float rrScaled=SR(4097.0f*rr.h);
 const float rrLead=SR(rrScaled-SR(rrScaled-rr.h)),rrTrail=SR(rr.h-rrLead);
 // The first two stages contribute only through rr^3 to the seed.
 // Evaluate that tail in FP32, retaining compensated arithmetic for all
 // three lower stages. |rr|<0.174 bounds the omitted tail error.
 const float tail0=SR(SR(0.00836168882f*rr.h)+0.0417186953f);
 const float tail1=SR(SR(tail0*rr.h)+0.166665971f);
 SF e={tail1,0.0f};
 e=ShortAddDominant(ShortMulFixed(e,rr,rrLead,rrTrail),{0.499999523f,0.0f});
 e=ShortAddDominant(ShortMulFixed(e,rr,rrLead,rrTrail),{1.0f,0.0f});
 e=ShortAddDominant(ShortMulFixed(e,rr,rrLead,rrTrail),{1.0f,0.0f});
 int halfShift=ei>>1;
 RopeBits bh;bh.u=(uint32_t)(halfShift+127)<<23;
 SF b2=ShortNormalize(SR(e.h*bh.f),SR(e.l*bh.f));
 if(ei&1)b2=SMul(b2,{1.4142135623730951f,-4.440892098500626e-16f});
 // Compare this call's compensated seed to its nearest rounding boundary.
 // The relative bound2^-29 is deliberately wider than the high-tail
 // FP32 error propagated over |rr|<0.174. It is not a frequency result.
 RopeBits rounded,halfUlp;rounded.f=b2.h;
 halfUlp.u=((((rounded.u>>23)&255u)-24u)<<23);
 float radius=halfUlp.f;
 if((rounded.u&0x7fffffu)==0u && b2.l<0.0f)radius=SR(radius*0.5f);
 const float lowMagnitude=b2.l<0.0f?-b2.l:b2.l;
 const float margin=SR(radius-lowMagnitude);
 const float errorBound=SR(b2.h*0x1p-29f);
 if(!(margin>errorBound)){
  // Ambiguous rounding keeps the entire original compensated evaluation.
 e={0.00836168882f,0.0f};
 e=ShortAddDominant(ShortMulFixed(e,rr,rrLead,rrTrail),{0.0417186953f,0.0f});
 e=ShortAddDominant(ShortMulFixed(e,rr,rrLead,rrTrail),{0.166665971f,0.0f});
 e=ShortAddDominant(ShortMulFixed(e,rr,rrLead,rrTrail),{0.499999523f,0.0f});
 e=ShortAddDominant(ShortMulFixed(e,rr,rrLead,rrTrail),{1.0f,0.0f});
 e=ShortAddDominant(ShortMulFixed(e,rr,rrLead,rrTrail),{1.0f,0.0f});

  b2=ShortNormalize(SR(e.h*bh.f),SR(e.l*bh.f));
  if(ei&1)b2=SMul(b2,{1.4142135623730951f,-4.440892098500626e-16f});
 }

 const float b=b2.h;
 SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(0,n);
 FDuplicate(inv,1.0f,n);FDuplicate(w,b,n);PipeBarrier<PIPE_V>();
 ShortLadderStage<0,true>(inv,w,n);
 ShortLadderStage<1,true>(inv,w,n);
 if(halfDim>8){
  ShortLadderStage<2,true>(inv,w,n);
  ShortLadderStage<3,false>(inv,w,n);
 }else ShortLadderStage<2,false>(inv,w,n);
 SetMaskNorm();ResetMask();
}

// The original path covers theta outside this numeric range, without Host math.
__aicore__ inline void MakeInv(LocalTensor<float> inv,LocalTensor<float> w,int halfDim,float theta){
 if(halfDim>=8 && halfDim<=16 && theta>=0x1p-32f && theta<=0x1p32f){MakeInvShort(inv,w,halfDim,theta);return;}
 if(theta>=0x1p-32f && theta<=0x1p32f)MakeInvGrid2(inv,w,halfDim,theta);
 else MakeInvOriginal(inv,w,halfDim,theta);
}

__aicore__ inline void Trig(LocalTensor<float> angle,LocalTensor<float> q,LocalTensor<float> t,LocalTensor<float> red,LocalTensor<float> square,LocalTensor<float> sn,LocalTensor<float> cs,int n){SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(0,n);
 FMuls(q,angle,0.3183098861837907f,n);FCast(sn.ReinterpretCast<int32_t>(),q,RoundMode::CAST_RINT,n);FCast(q,sn.ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,n);FMuls(t,q,3.140625f,n);FSub(red,angle,t,n);FMuls(t,q,0.0009670257568359375f,n);FSub(red,red,t,n);FMuls(t,q,0.0000006278329573005f,n);FSub(red,red,t,n);FShiftLeft(q.ReinterpretCast<uint32_t>(),sn.ReinterpretCast<uint32_t>(),(uint32_t)31,n);FAdds(q.ReinterpretCast<int32_t>(),q.ReinterpretCast<int32_t>(),(int32_t)0x3f800000,n);FMul(square,red,red,n);
 // v=2*sin(r/2), with a universal degree5 odd polynomial.
 // Then cos(r)=1-v*v/2 and sin(r)=v*sqrt(1-v*v/4).
 // On the reduced interval the sqrt argument is at least 1/2.
 FMuls(sn,square,0x1.0b1bca0000000p-11f,n);FAdds(sn,sn,-0x1.553f580000000p-5f,n);
 FMul(sn,sn,square,n);FAdds(sn,sn,0x1.ffffd00000000p-1f,n);FMul(sn,sn,red,n);
 FMul(square,sn,sn,n);
 FMuls(cs,square,-0.5f,n);FAdds(cs,cs,1.0f,n);
 FMuls(t,square,-0.25f,n);FAdds(t,t,1.0f,n);
 Sqrt<float,false>(t,t,(uint64_t)0,1,{1,1,8,8});
 FMul(sn,sn,t,n);FMul(cs,cs,q,n);FMul(sn,sn,q,n);
 SetMaskNorm();ResetMask();
}
__aicore__ inline void RopeAngles(TQue<QuePosition::VECIN,1>& qp,GlobalTensor<int32_t>& gp,LocalTensor<float> angle,LocalTensor<float> q,LocalTensor<float> tmp,LocalTensor<float> inv,int64_t token,int count,int stride){
 auto pos=qp.AllocTensor<int32_t>();DataCopyExtParams cp{1,(uint32_t)(count*4),0,0,0};DataCopyPadExtParams<int32_t> pad{false,0,0,0};DataCopyPad(pos,gp[token],cp,pad);qp.EnQue(pos);PipeBarrier<PIPE_V>();pos=qp.DeQue<int32_t>();Cast(q,pos,RoundMode::CAST_NONE,count);PipeBarrier<PIPE_V>();qp.FreeTensor(pos);
 Brcb(tmp,q,(count+7)/8,{1,8});PipeBarrier<PIPE_V>();
 if(stride==8 && count>=8 && (count&7)==0){
  Mul(angle,inv,tmp,64,count/8,{1,0,1,8,0,8});
 }else{
 BinaryRepeatParams br{1,1,0,(uint8_t)(stride/8),0,1};
 for(int begin=0;begin<count;begin+=255){int repeats=RopeMin(255,count-begin);for(int j=0;j<stride;j+=64)Mul(angle[begin*stride+j],inv[j],tmp[begin*8],RopeMin(64,stride-j),repeats,br);}
 }
 PipeBarrier<PIPE_V>();
}


// Wide dimensions use bounded dimension slices rather than a zero row tile.
// The complete inverse-frequency chain and trigonometry execute on the NPU
// in this kernel invocation. Every row and both rotation halves are written.
template<class T> class RopeWide {
 TPipe& pipe;
 TQue<QuePosition::VECIN,1> qi,qp;
 TQue<QuePosition::VECOUT,1> qo;
 TBuf<QuePosition::VECCALC> buf;
 GlobalTensor<T> gx,gy;
 GlobalTensor<int32_t> gp;
 static constexpr int CAP=256;
public:
 __aicore__ inline RopeWide(TPipe& owner):pipe(owner){}
 __aicore__ inline void Run(GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){
  const int halfDim=p.fullHalf,align=32/sizeof(T);
  gx.SetGlobalBuffer((__gm__ T*)x);
  if(p.bypassX)gx.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
  gy.SetGlobalBuffer((__gm__ T*)y);
  gp.SetGlobalBuffer((__gm__ int32_t*)positions);
  pipe.InitBuffer(qi,1,2*CAP*sizeof(T));
  pipe.InitBuffer(qo,1,2*CAP*sizeof(T));
  pipe.InitBuffer(qp,1,32);
  // 24 inverse scratch rows, one inverse row, eight trig rows,
  // two converted input rows, and two converted output rows.
  pipe.InitBuffer(buf,37*CAP*sizeof(float));
  auto mem=buf.Get<float>(),inv=mem[24*CAP],angle=mem[25*CAP];
  auto q=mem[26*CAP],temp=mem[27*CAP],red=mem[28*CAP];
  auto square=mem[29*CAP],sn=mem[30*CAP],cs=mem[31*CAP];
  auto neg=mem[32*CAP],xf=mem[33*CAP],uf=mem[35*CAP];
  const int64_t rows=p.tokens*(int64_t)p.heads;
  const int64_t block=GetBlockIdx(),blocks=GetBlockNum();
  const int64_t first=rows*block/blocks,last=rows*(block+1)/blocks;
  // Adjacent row intervals cover [0,rows), including the final remainder.
  for(int64_t row=first;row<last;++row){
   const int64_t token=row/p.heads;
   for(int64_t begin=0;begin<halfDim;begin+=CAP){
    const int count=RopeMin(CAP,(int)(halfDim-begin));
    const int pitch=(count+align-1)/align*align;
    const int n=(count+15)/16*16;
    const int64_t off=row*(2LL*halfDim)+begin;
    auto input=qi.AllocTensor<T>();
    DataCopyExtParams read{2,(uint32_t)(count*sizeof(T)),
     (uint32_t)((int64_t)(halfDim-count)*sizeof(T)),0,0};
    DataCopyPadExtParams<T> padding{true,0,(uint8_t)(pitch-count),(T)0};
    DataCopyPad(input,gx[off],read,padding);
    qi.EnQue(input);
    if(p.theta>=0x1p-32f && p.theta<=0x1p32f)
     MakeInvGrid2<true>(inv,mem,halfDim,p.theta,(int)begin,count);
    else MakeInvOriginal<true>(inv,mem,halfDim,p.theta,(int)begin,count);
    PipeBarrier<PIPE_V>();
    // Define even the unused Brcb source lanes in this invocation.
    Duplicate(q,0.0f,8);PipeBarrier<PIPE_V>();
    RopeAngles(qp,gp,angle,q,temp,inv,token,1,n);
    Trig(angle,q,temp,red,square,sn,cs,n);
    Muls(neg,sn,-1.0f,n);PipeBarrier<PIPE_V>();
    input=qi.DeQue<T>();
    auto output=qo.AllocTensor<T>();
    LocalTensor<float> a,u;
    if constexpr(sizeof(T)==2){
     a=xf;u=uf;Cast(a,input,RoundMode::CAST_NONE,2*pitch);
    }else{
     a=input.template ReinterpretCast<float>();
     u=output.template ReinterpretCast<float>();
    }
    Duplicate(u,0.0f,2*pitch);PipeBarrier<PIPE_V>();
    Mul(u,a,cs,count);Mul(u[pitch],a[pitch],cs,count);
    PipeBarrier<PIPE_V>();
    MulAddDst(u,a[pitch],neg,count);
    MulAddDst(u[pitch],a,sn,count);
    PipeBarrier<PIPE_V>();
    if constexpr(sizeof(T)==2)Cast(output,u,RoundMode::CAST_RINT,2*pitch);
    qi.FreeTensor(input);
    qo.EnQue(output);output=qo.DeQue<T>();
    // Copy both valid halves; omit only UB padding, never logical output.
    DataCopyExtParams write{2,(uint32_t)(count*sizeof(T)),0,
     (uint32_t)((int64_t)(halfDim-count)*sizeof(T)),0};
    DataCopyPad(gy[off],output,write);qo.FreeTensor(output);
   }
  }
 }
};
template<class T> __global__ __vector__ void rotary_wide_kernel(
 GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){
 TPipe pipe;RopeWide<T> op(pipe);op.Run(x,positions,y,p);
}

template<class T> class RopeBatch {
 TPipe& pipe;TQue<QuePosition::VECIN,2> qa;TQue<QuePosition::VECIN,1> qp;TQue<QuePosition::VECOUT,2> qo;TBuf<QuePosition::VECCALC> buf;GlobalTensor<T> gx,gy;GlobalTensor<int32_t> gp;
 __aicore__ inline void Load(int64_t off,int count){auto input=qa.AllocTensor<T>();DataCopy(input,gx[off],count);qa.EnQue(input);}
public:
 __aicore__ inline RopeBatch(TPipe& p):pipe(p){}
 __aicore__ inline void Run(GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){
 const int cap=4096,d=p.fullHalf;const bool compact=sizeof(T)==4;gx.SetGlobalBuffer((__gm__ T*)x);if(p.bypassX)gx.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);gy.SetGlobalBuffer((__gm__ T*)y);gp.SetGlobalBuffer((__gm__ int32_t*)positions);pipe.InitBuffer(qp,1,cap/8*4);pipe.InitBuffer(qa,2,2*cap*sizeof(T));pipe.InitBuffer(qo,(sizeof(T)==4 && !compact)?1:2,2*cap*sizeof(T));pipe.InitBuffer(buf,((sizeof(T)==4?(compact?3:5):7)*cap+512)*4);
 auto mem=buf.Get<float>();auto a=mem,b=mem[cap],u=mem[2*cap],v=mem[3*cap],tmp=mem[(sizeof(T)==4?(compact?0:2):4)*cap],sn=mem[(sizeof(T)==4?(compact?1:3):5)*cap],cs=mem[(sizeof(T)==4?(compact?2:4):6)*cap],inv=mem[(sizeof(T)==4?(compact?3:5):7)*cap];
 int ht=RopeMin(RopeHeadTile(p.heads,cap/d,p.tokens),128);int tt=RopeMin(64,cap/(ht*d));if(ht<p.heads)tt=1;tt=RopeMin(tt,(int)((p.tokens+GetBlockNum()-1)/GetBlockNum()));const bool wideCos=(d==16 || d==32) && ht>=32;int hb=(p.heads+ht-1)/ht;int64_t tokenTiles=(p.tokens+tt-1)/tt;
 int64_t taskFirst=RopeTaskBoundary(tokenTiles,hb,p.tokens,GetBlockIdx()),taskLast=RopeTaskBoundary(tokenTiles,hb,p.tokens,GetBlockIdx()+1),cacheStart=-1,cacheEnd=-1;
 if(taskFirst<taskLast){int64_t tok=(taskFirst/hb)*tt;int h=(taskFirst%hb)*ht;Load((tok*p.heads+h)*2*d,2*RopeMin(tt,(int)(p.tokens-tok))*RopeMin(ht,p.heads-h)*d);}

 MakeInv(inv,mem,d,p.theta);PipeBarrier<PIPE_V>();
 for(int64_t task=taskFirst;task<taskLast;task++){a=mem;u=mem[2*cap];
 int64_t tok=(task/hb)*tt;int h=(task%hb)*ht;int nt=RopeMin(tt,(int)(p.tokens-tok)),nh=RopeMin(ht,p.heads-h);int rows=nt*nh,count=rows*d;if(tok<cacheStart || tok+nt>cacheEnd){cacheStart=tok;int cacheCount=RopeMin((wideCos?cap/2:cap)/d/tt*tt,(int)(p.tokens-tok));cacheCount=RopeMin(cacheCount,(int)(((taskLast+hb-1)/hb)*tt-tok));cacheEnd=tok+cacheCount;LocalTensor<T> cacheWork;if(compact){cacheWork=qo.AllocTensor<T>();a=cacheWork.template ReinterpretCast<float>();b=a[cap];}RopeAngles(qp,gp,a,b,tmp,inv,tok,cacheCount,d);Trig(a,b,tmp,a,tmp,sn,cs,cacheCount*d);Muls(tmp,sn,-1.0f,cacheCount*d);PipeBarrier<PIPE_V>();if(wideCos){
 // Store [cos, cos] for a whole head. The halved cache count keeps the
 // expanded cosine cache within its original cap-float allocation.
 UnaryRepeatParams pack{1,1,(uint8_t)(2*d/8),(uint8_t)(d/8)};
 Muls(a,cs,1.0f,d,cacheCount,pack);
 Muls(a[d],cs,1.0f,d,cacheCount,pack);
 PipeBarrier<PIPE_V>();
 Muls(cs,a,1.0f,2*cacheCount*d);PipeBarrier<PIPE_V>();
}if(compact){PipeBarrier<PIPE_V>();qo.FreeTensor(cacheWork);}}int64_t off=(tok*p.heads+h)*2*d;
 auto ia=qa.DeQue<T>();
 if(task+1<taskLast){int64_t nextTok=((task+1)/hb)*tt;int nextH=((task+1)%hb)*ht;Load((nextTok*p.heads+nextH)*2*d,2*RopeMin(tt,(int)(p.tokens-nextTok))*RopeMin(ht,p.heads-nextH)*d);}
auto o0=qo.AllocTensor<T>();if constexpr(sizeof(T)==2)Cast(a,ia,RoundMode::CAST_NONE,2*count);else {a=ia.template ReinterpretCast<float>();u=o0.template ReinterpretCast<float>();}PipeBarrier<PIPE_V>();
 if(wideCos){
  BinaryRepeatParams whole{1,1,1,(uint8_t)(2*d/8),(uint8_t)(2*d/8),0};
  for(int tokj=0;tokj<nt;tokj++){
   int o=tokj*nh*2*d,c=((int)(tok-cacheStart)+tokj)*d;
   Mul(u[o],a[o],cs[2*c],2*d,nh,whole);
  }
  PipeBarrier<PIPE_V>();
  for(int tokj=0;tokj<nt;tokj++){
   int o=tokj*nh*2*d,c=((int)(tok-cacheStart)+tokj)*d;
   MulAddDst(u[o],a[o+d],tmp[c],d,nh,whole);
   MulAddDst(u[o+d],a[o],sn[c],d,nh,whole);
  }
  PipeBarrier<PIPE_V>();
 }else if(nh>=8 && (d==8 || (d==16 && nt>(nh+7)/8 && 2*nh*d/8<=255))){
  // Within one repeat, each 32B block handles another head's eight columns.
  // Repeats advance over head groups or tokens, whichever saves API issues.
  const int groups=nh/8, tail=nh%8;
  const bool packTokens=nt>(nh+7)/8 && 2*nh*d/8<=255;
  const int nouter=packTokens?(nh+7)/8:nt;
  const int repeats=packTokens?nt:groups;
  BinaryRepeatParams packed{(uint8_t)(2*d/8),(uint8_t)(2*d/8),0,
   (uint8_t)(packTokens?2*nh*d/8:2*d),(uint8_t)(packTokens?2*nh*d/8:2*d),(uint8_t)(packTokens?d/8:0)};
  for(int t=0;t<nouter;t++)for(int j=0;j<d;j+=8){
   int o=2*t*(packTokens?8:nh)*d+j,c=((packTokens?0:t)+(int)(tok-cacheStart))*d+j;
   int mask=packTokens?8*RopeMin(8,nh-8*t):64;
   Mul(u[o],a[o],cs[c],mask,repeats,packed);
   Mul(u[o+d],a[o+d],cs[c],mask,repeats,packed);
   if(!packTokens && tail){int z=o+groups*16*d;Mul(u[z],a[z],cs[c],8*tail,1,packed);Mul(u[z+d],a[z+d],cs[c],8*tail,1,packed);}
  }
  for(int t=0;t<nouter;t++)for(int j=0;j<d;j+=8){
   int o=2*t*(packTokens?8:nh)*d+j,c=((packTokens?0:t)+(int)(tok-cacheStart))*d+j;
   int mask=packTokens?8*RopeMin(8,nh-8*t):64;
   MulAddDst(u[o],a[o+d],tmp[c],mask,repeats,packed);
   MulAddDst(u[o+d],a[o],sn[c],mask,repeats,packed);
   if(!packTokens && tail){int z=o+groups*16*d;MulAddDst(u[z],a[z+d],tmp[c],8*tail,1,packed);MulAddDst(u[z+d],a[z],sn[c],8*tail,1,packed);}
  }
  PipeBarrier<PIPE_V>();
 }else{
 bool repeatTokens=nt>nh && 2*nh*d/8<=255;int nouter=repeatTokens?nh:nt,nrepeat=repeatTokens?nt:nh;int dataRepeat=repeatTokens?2*nh*d/8:2*d/8,trigRepeat=repeatTokens?d/8:0;
 BinaryRepeatParams bc{1,1,1,(uint8_t)dataRepeat,(uint8_t)dataRepeat,(uint8_t)trigRepeat};
 for(int tokj=0;tokj<nouter;tokj++)for(int j=0;j<d;j+=64){int m=RopeMin(64,d-j),o=2*tokj*(repeatTokens?1:nh)*d+j,c=((repeatTokens?0:tokj)+(int)(tok-cacheStart))*d+j;Mul(u[o],a[o],cs[c],m,nrepeat,bc);Mul(u[o+d],a[o+d],cs[c],m,nrepeat,bc);}
 for(int tokj=0;tokj<nouter;tokj++)for(int j=0;j<d;j+=64){int m=RopeMin(64,d-j),o=2*tokj*(repeatTokens?1:nh)*d+j,c=((repeatTokens?0:tokj)+(int)(tok-cacheStart))*d+j;MulAddDst(u[o],a[o+d],tmp[c],m,nrepeat,bc);MulAddDst(u[o+d],a[o],sn[c],m,nrepeat,bc);}PipeBarrier<PIPE_V>(); }
qa.FreeTensor(ia);
 if constexpr(sizeof(T)==2)Cast(o0,u,RoundMode::CAST_RINT,2*count);qo.EnQue(o0);o0=qo.DeQue<T>();DataCopy(gy[off],o0,2*count);qo.FreeTensor(o0);
 }

 }
};

template<class T> class RopePaddedBatch {
 TPipe& pipe;TQue<QuePosition::VECIN,2> qa;TQue<QuePosition::VECIN,1> qp;TQue<QuePosition::VECOUT,2> qo;TBuf<QuePosition::VECCALC> buf;GlobalTensor<T> gx,gy;GlobalTensor<int32_t> gp;
 int logicalDim,paddedDim;
 __aicore__ inline void Load(int64_t off,int count){
  auto input=qa.AllocTensor<T>();
  DataCopyExtParams cp{(uint16_t)(count/paddedDim),(uint32_t)(logicalDim*sizeof(T)),0,0,0};
  DataCopyPadExtParams<T> pad{false,0,0,(T)0};
  DataCopyPad(input,gx[off],cp,pad);qa.EnQue(input);
 }
public:
 __aicore__ inline RopePaddedBatch(TPipe& p):pipe(p){}
 __aicore__ inline void Run(GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){
 const int cap=4096,logical=p.fullHalf,alignment=32/sizeof(T),d=(logical+alignment-1)/alignment*alignment;logicalDim=logical;paddedDim=d;const bool compact=sizeof(T)==4;gx.SetGlobalBuffer((__gm__ T*)x);if(p.bypassX)gx.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);gy.SetGlobalBuffer((__gm__ T*)y);gp.SetGlobalBuffer((__gm__ int32_t*)positions);pipe.InitBuffer(qp,1,cap/8*4);pipe.InitBuffer(qa,2,2*cap*sizeof(T));pipe.InitBuffer(qo,(sizeof(T)==4 && !compact)?1:2,2*cap*sizeof(T));pipe.InitBuffer(buf,((sizeof(T)==4?(compact?3:5):7)*cap+512)*4);
 auto mem=buf.Get<float>();auto a=mem,b=mem[cap],u=mem[2*cap],v=mem[3*cap],tmp=mem[(sizeof(T)==4?(compact?0:2):4)*cap],sn=mem[(sizeof(T)==4?(compact?1:3):5)*cap],cs=mem[(sizeof(T)==4?(compact?2:4):6)*cap],inv=mem[(sizeof(T)==4?(compact?3:5):7)*cap];
 int ht=RopeMin(RopeHeadTile(p.heads,cap/d,p.tokens),128);int tt=RopeMin(64,cap/(ht*d));if(ht<p.heads)tt=1;tt=RopeMin(tt,(int)((p.tokens+GetBlockNum()-1)/GetBlockNum()));int hb=(p.heads+ht-1)/ht;int64_t tokenTiles=(p.tokens+tt-1)/tt;
 int64_t taskFirst=RopeTaskBoundary(tokenTiles,hb,p.tokens,GetBlockIdx()),taskLast=RopeTaskBoundary(tokenTiles,hb,p.tokens,GetBlockIdx()+1),cacheStart=-1,cacheEnd=-1;
 if(taskFirst<taskLast){int64_t tok=(taskFirst/hb)*tt;int h=(taskFirst%hb)*ht;Load((tok*p.heads+h)*2*logical,2*RopeMin(tt,(int)(p.tokens-tok))*RopeMin(ht,p.heads-h)*d);}

 MakeInv(inv,mem,logical,p.theta);PipeBarrier<PIPE_V>();
 // Define any further FP16 pitch padding before vector operations
 // consume the complete padded row.
 const int loadedInv=(logical+7)/8*8;
 if(d>loadedInv){Duplicate(inv[loadedInv],0.0f,d-loadedInv);PipeBarrier<PIPE_V>();}

 for(int64_t task=taskFirst;task<taskLast;task++){a=mem;u=mem[2*cap];
 int64_t tok=(task/hb)*tt;int h=(task%hb)*ht;int nt=RopeMin(tt,(int)(p.tokens-tok)),nh=RopeMin(ht,p.heads-h);int rows=nt*nh,count=rows*d;if(tok<cacheStart || tok+nt>cacheEnd){cacheStart=tok;int cacheCount=RopeMin(cap/d/tt*tt,(int)(p.tokens-tok));cacheCount=RopeMin(cacheCount,(int)(((taskLast+hb-1)/hb)*tt-tok));cacheEnd=tok+cacheCount;LocalTensor<T> cacheWork;if(compact){cacheWork=qo.AllocTensor<T>();a=cacheWork.template ReinterpretCast<float>();b=a[cap];}RopeAngles(qp,gp,a,b,tmp,inv,tok,cacheCount,d);Trig(a,b,tmp,a,tmp,sn,cs,cacheCount*d);Muls(tmp,sn,-1.0f,cacheCount*d);PipeBarrier<PIPE_V>();if(compact){PipeBarrier<PIPE_V>();qo.FreeTensor(cacheWork);}}int64_t off=(tok*p.heads+h)*2*logical;
 auto ia=qa.DeQue<T>();
 if(task+1<taskLast){int64_t nextTok=((task+1)/hb)*tt;int nextH=((task+1)%hb)*ht;Load((nextTok*p.heads+nextH)*2*logical,2*RopeMin(tt,(int)(p.tokens-nextTok))*RopeMin(ht,p.heads-nextH)*d);}
auto o0=qo.AllocTensor<T>();if constexpr(sizeof(T)==2)Cast(a,ia,RoundMode::CAST_NONE,2*count);else {a=ia.template ReinterpretCast<float>();u=o0.template ReinterpretCast<float>();}PipeBarrier<PIPE_V>();
 if(nh>=8 && (d==8 || (d==16 && nt>(nh+7)/8 && 2*nh*d/8<=255))){
  // Within one repeat, each 32B block handles another head's eight columns.
  // Repeats advance over head groups or tokens, whichever saves API issues.
  const int groups=nh/8, tail=nh%8;
  const bool packTokens=nt>(nh+7)/8 && 2*nh*d/8<=255;
  const int nouter=packTokens?(nh+7)/8:nt;
  const int repeats=packTokens?nt:groups;
  BinaryRepeatParams packed{(uint8_t)(2*d/8),(uint8_t)(2*d/8),0,
   (uint8_t)(packTokens?2*nh*d/8:2*d),(uint8_t)(packTokens?2*nh*d/8:2*d),(uint8_t)(packTokens?d/8:0)};
  for(int t=0;t<nouter;t++)for(int j=0;j<d;j+=8){
   int o=2*t*(packTokens?8:nh)*d+j,c=((packTokens?0:t)+(int)(tok-cacheStart))*d+j;
   int mask=packTokens?8*RopeMin(8,nh-8*t):64;
   Mul(u[o],a[o],cs[c],mask,repeats,packed);
   Mul(u[o+d],a[o+d],cs[c],mask,repeats,packed);
   if(!packTokens && tail){int z=o+groups*16*d;Mul(u[z],a[z],cs[c],8*tail,1,packed);Mul(u[z+d],a[z+d],cs[c],8*tail,1,packed);}
  }
  for(int t=0;t<nouter;t++)for(int j=0;j<d;j+=8){
   int o=2*t*(packTokens?8:nh)*d+j,c=((packTokens?0:t)+(int)(tok-cacheStart))*d+j;
   int mask=packTokens?8*RopeMin(8,nh-8*t):64;
   MulAddDst(u[o],a[o+d],tmp[c],mask,repeats,packed);
   MulAddDst(u[o+d],a[o],sn[c],mask,repeats,packed);
   if(!packTokens && tail){int z=o+groups*16*d;MulAddDst(u[z],a[z+d],tmp[c],8*tail,1,packed);MulAddDst(u[z+d],a[z],sn[c],8*tail,1,packed);}
  }
  PipeBarrier<PIPE_V>();
 }else{
 bool repeatTokens=nt>nh && 2*nh*d/8<=255;int nouter=repeatTokens?nh:nt,nrepeat=repeatTokens?nt:nh;int dataRepeat=repeatTokens?2*nh*d/8:2*d/8,trigRepeat=repeatTokens?d/8:0;
 BinaryRepeatParams bc{1,1,1,(uint8_t)dataRepeat,(uint8_t)dataRepeat,(uint8_t)trigRepeat};
 for(int tokj=0;tokj<nouter;tokj++)for(int j=0;j<d;j+=64){int m=RopeMin(64,d-j),o=2*tokj*(repeatTokens?1:nh)*d+j,c=((repeatTokens?0:tokj)+(int)(tok-cacheStart))*d+j;Mul(u[o],a[o],cs[c],m,nrepeat,bc);Mul(u[o+d],a[o+d],cs[c],m,nrepeat,bc);}
 for(int tokj=0;tokj<nouter;tokj++)for(int j=0;j<d;j+=64){int m=RopeMin(64,d-j),o=2*tokj*(repeatTokens?1:nh)*d+j,c=((repeatTokens?0:tokj)+(int)(tok-cacheStart))*d+j;MulAddDst(u[o],a[o+d],tmp[c],m,nrepeat,bc);MulAddDst(u[o+d],a[o],sn[c],m,nrepeat,bc);}PipeBarrier<PIPE_V>(); }
qa.FreeTensor(ia);
 if constexpr(sizeof(T)==2)Cast(o0,u,RoundMode::CAST_RINT,2*count);qo.EnQue(o0);o0=qo.DeQue<T>();DataCopyExtParams cp{(uint16_t)(2*count/d),(uint32_t)(logical*sizeof(T)),0,0,0};DataCopyPad(gy[off],o0,cp);qo.FreeTensor(o0);
 }

 }
};

template<class T> class RopeFilter {
 GlobalTensor<T> gx,gy;GlobalTensor<int32_t> gp;
 static constexpr bool FP=sizeof(T)==4;
 // Half input compacts before conversion: two n-half strips replace the
 // former2*n-float cast strip, leaving space for a20% larger data tile.
 static constexpr int CAP=FP?2560:3072,CACHE=2176,POS=CACHE/8,IO=2*CAP;
 static constexpr int CORE_WORK=(FP?9:10)*CAP;
 static constexpr int MASK_BASE=CORE_WORK+2*CACHE+512;
 static constexpr int WORK=MASK_BASE+384;
 // CompareScalar's mask addresses must remain256B aligned after the
 // coefficient-cache increase changes the logical position buffer size.
 static constexpr int INPUT0=(POS*4+255)/256*256,INPUT1=INPUT0+IO*sizeof(T);
 static constexpr int OUTPUT0=INPUT1+IO*sizeof(T),OUTPUT1=OUTPUT0+IO*sizeof(T);
 static constexpr int WORK_OFFSET=OUTPUT1+IO*sizeof(T);
 __aicore__ inline void SetInputReady(int slot){
  if(slot==0){
   SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
  }else{
   SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
  }
 }
 __aicore__ inline void WaitInputReady(int slot){
  if(slot==0){
   WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
  }else{
   WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
  }
 }
 __aicore__ inline void SetInputFree(int slot){
  if(slot==0){
   SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }else{
   SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
  }
 }
 __aicore__ inline void WaitInputFree(int slot){
  if(slot==0){
   WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }else{
   WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
  }
 }
 __aicore__ inline void SetOutputReady(int slot){
  if(slot==0){
   SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  }else{
   SetFlag<HardEvent::V_MTE3>(EVENT_ID1);
  }
 }
 __aicore__ inline void WaitOutputReady(int slot){
  if(slot==0){
   WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  }else{
   WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);
  }
 }
 __aicore__ inline void SetOutputFree(int slot){
  if(slot==0){
   SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }else{
   SetFlag<HardEvent::MTE3_V>(EVENT_ID1);
  }
 }
 __aicore__ inline void WaitOutputFree(int slot){
  if(slot==0){
   WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }else{
   WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);
  }
 }
 __aicore__ inline void Load(LocalTensor<T> input,int slot,int64_t off,int count){
  WaitInputFree(slot);
  DataCopyExtParams cp{1,(uint32_t)(count*sizeof(T)),0,0,0};
  DataCopyPadExtParams<T> pad{false,0,0,0};
  DataCopyPad(input,gx[off],cp,pad);
  SetInputReady(slot);
 }

 __aicore__ inline void BuildLayout(LocalTensor<float> mem,int d,int ht,int pitch,int pairCount){
  // 0<pairCount<=CAP; CAP is a multiple of32, so total<=2*CAP.
  // CompareScalar consumes64-lane groups. Rounded unused layout entries
  // are initialized too, and every later Gather uses only its valid prefix.
  const int total=(2*pairCount+63)/64*64;
  auto i=mem,h=mem[2*CAP],row=mem[4*CAP],pack=mem[7*CAP];
  auto maskA=mem[MASK_BASE].template ReinterpretCast<uint8_t>();
  auto maskB=mem[MASK_BASE+192].template ReinterpretCast<uint8_t>();
  FArange(i,0.0f,1.0f,total);
  FMuls(h,i,1.0f/(float)d,total);FAdds(h,h,0.0001f,total);
  FCast(h.template ReinterpretCast<int32_t>(),h,RoundMode::CAST_FLOOR,total);
  FCast(h,h.template ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,total);
  FMuls(row,h,0.5f,total);
  FCast(row.template ReinterpretCast<int32_t>(),row,RoundMode::CAST_FLOOR,total);
  FCast(row,row.template ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,total);
  FMuls(pack,h,(float)d,total);FSub(pack,i,pack,total);
  FMuls(i,row,(float)d,total);FAdd(pack,pack,i,total);
  FMuls(i,row,2.0f,total);FSub(i,h,i,total);
  FMuls(h,i,(float)CAP,total);FAdd(pack,pack,h,total);
  FMuls(pack,pack,4.0f,total);
  FCast(pack.template ReinterpretCast<int32_t>(),pack,RoundMode::CAST_RINT,total);
  PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
  // 2*CAP is a multiple of64; both packed mask starts are256B aligned.
  CompareScalar(maskA,i,0.5f,CMPMODE::LT,(uint32_t)total);
  CompareScalar(maskB,i,0.5f,CMPMODE::GE,(uint32_t)total);
  PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
  // One coefficient per dimension pair, reused by both rotated halves.
  auto pair=mem[6*CAP];
  FArange(i,0.0f,1.0f,pairCount);
  FMuls(h,i,1.0f/(float)d,pairCount);FAdds(h,h,0.0001f,pairCount);
  FCast(h.template ReinterpretCast<int32_t>(),h,RoundMode::CAST_FLOOR,pairCount);
  FCast(h,h.template ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,pairCount);
  FMuls(pair,h,(float)d,pairCount);FSub(pair,i,pair,pairCount);
  FMuls(row,i,1.0f/(float)(ht*d),pairCount);FAdds(row,row,0.0001f,pairCount);
  FCast(row.template ReinterpretCast<int32_t>(),row,RoundMode::CAST_FLOOR,pairCount);
  FCast(row,row.template ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,pairCount);
  FMuls(row,row,(float)pitch,pairCount);FAdd(pair,pair,row,pairCount);
  FMuls(pair,pair,4.0f,pairCount);
  FCast(pair.template ReinterpretCast<int32_t>(),pair,RoundMode::CAST_RINT,pairCount);
  PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
 }
public:
 __aicore__ inline void Run(GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){
  InitSocState();
  const int d=p.fullHalf,pitch=(d+7)/8*8;
  gx.SetGlobalBuffer((__gm__ T*)x);if(p.bypassX)gx.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
  gy.SetGlobalBuffer((__gm__ T*)y);gp.SetGlobalBuffer((__gm__ int32_t*)positions);
  LocalTensor<int32_t> pos(TPosition::VECIN,0,POS);
  LocalTensor<T> input0(TPosition::VECIN,INPUT0,IO),input1(TPosition::VECIN,INPUT1,IO);
  LocalTensor<T> output0(TPosition::VECOUT,OUTPUT0,IO),output1(TPosition::VECOUT,OUTPUT1,IO);
  LocalTensor<float> mem(TPosition::VECCALC,WORK_OFFSET,WORK);
  auto left=mem,right=mem[CAP],cosPair=mem[2*CAP],sinPair=mem[3*CAP];
  auto outLeft=mem[4*CAP],outRight=mem[5*CAP];
  auto pairIndex=mem[6*CAP].template ReinterpretCast<uint32_t>();
  auto packIndex=mem[7*CAP].template ReinterpretCast<uint32_t>();
  auto sn=mem[CORE_WORK],cs=mem[CORE_WORK+CACHE],inv=mem[CORE_WORK+2*CACHE];
  auto maskA=mem[MASK_BASE].template ReinterpretCast<uint32_t>();
  auto maskB=mem[MASK_BASE+192].template ReinterpretCast<uint32_t>();
  int ht=RopeHeadTile(p.heads,CAP/d,p.tokens);
  int tt=RopeMin(64,CAP/(ht*d));if(ht<p.heads)tt=1;
  tt=RopeMin(tt,(int)((p.tokens+GetBlockNum()-1)/GetBlockNum()));
  tt=RopeMin(tt,CACHE/pitch);
  const int ttBal=(int)((p.tokens+(int64_t)GetBlockNum()*8-1)/((int64_t)GetBlockNum()*8));
  tt=RopeMin(tt,ttBal>0?ttBal:1);
  const int hb=(p.heads+ht-1)/ht;
  const int64_t tiles=(p.tokens+tt-1)/tt;
  const int64_t first=RopeTaskBoundary(tiles,hb,p.tokens,GetBlockIdx());
  const int64_t last=RopeTaskBoundary(tiles,hb,p.tokens,GetBlockIdx()+1);
  int64_t coreEnd=((last+hb-1)/hb)*tt;if(coreEnd>p.tokens)coreEnd=p.tokens;
  int64_t cacheStart=-1,cacheEnd=-1;
  SetFlag<HardEvent::V_MTE2>(EVENT_ID0);SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
  SetFlag<HardEvent::V_MTE2>(EVENT_ID2);
  SetFlag<HardEvent::MTE3_V>(EVENT_ID0);SetFlag<HardEvent::MTE3_V>(EVENT_ID1);
  if(first<last){
   const int64_t tok=(first/hb)*tt;const int h=(int)(first%hb)*ht;
   Load(input0,0,(tok*p.heads+h)*2*d,2*RopeMin(tt,(int)(p.tokens-tok))*RopeMin(ht,p.heads-h)*d);
  }
  MakeInv(inv,mem,d,p.theta);PipeBarrier<PIPE_V>();
  BuildLayout(mem,d,ht,pitch,ht*tt*d);
  for(int64_t task=first;task<last;task++){
   const int64_t tok=(task/hb)*tt;const int h=(int)(task%hb)*ht;
   const int nt=RopeMin(tt,(int)(p.tokens-tok)),nh=RopeMin(ht,p.heads-h),n=nt*nh*d;
   if(tok<cacheStart || tok+nt>cacheEnd){
    cacheStart=tok;int cc=RopeMin(CACHE/pitch/tt*tt,(int)(p.tokens-tok));
    cc=RopeMin(cc,(int)(coreEnd-tok));cacheEnd=tok+cc;
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID2);
    DataCopyExtParams cp{1,(uint32_t)(cc*4),0,0,0};
    DataCopyPadExtParams<int32_t> pad{false,0,0,0};
    DataCopyPad(pos,gp[tok],cp,pad);SetFlag<HardEvent::MTE2_V>(EVENT_ID2);
    Duplicate(right,0.0f,(cc+7)/8*8);PipeBarrier<PIPE_V>();
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID2);
    Cast(right,pos,RoundMode::CAST_NONE,cc);PipeBarrier<PIPE_V>();
    SetFlag<HardEvent::V_MTE2>(EVENT_ID2);
    Brcb(cosPair,right,(cc+7)/8,{1,8});PipeBarrier<PIPE_V>();
    BinaryRepeatParams angleBr{1,1,0,(uint8_t)(pitch/8),0,1};
    for(int j=0;j<pitch;j+=64)
     Mul(left[j],inv[j],cosPair,RopeMin(64,pitch-j),cc,angleBr);
    PipeBarrier<PIPE_V>();
    Trig(left,right,cosPair,left,cosPair,sn,cs,cc*pitch);
   }
   const int slot=(int)((task-first)&1);
   auto input=slot==0?input0:input1;
   WaitInputReady(slot);
   if(task+1<last){
    const int64_t nextTok=((task+1)/hb)*tt;const int nextH=(int)((task+1)%hb)*ht;
    auto next=slot==0?input1:input0;
    Load(next,slot^1,(nextTok*p.heads+nextH)*2*d,
     2*RopeMin(tt,(int)(p.tokens-nextTok))*RopeMin(ht,p.heads-nextH)*d);
   }
   WaitOutputFree(slot);auto output=slot==0?output0:output1;
   uint64_t retainedA=0,retainedB=0;
   // One outer repeat consumes the complete valid source count and its bitmask.
   if constexpr(FP){
    auto source=input.template ReinterpretCast<float>();
    GatherMask(left,source,maskA,true,(uint32_t)(2*n),{1,1,8,0},retainedA);
    GatherMask(right,source,maskB,true,(uint32_t)(2*n),{1,1,8,0},retainedB);
   }else{
    auto rawLeft=mem[9*CAP].template ReinterpretCast<half>();
    auto rawRight=rawLeft[CAP];
    // A2 requires a uint16_t collection mask for a16-bit destination.
    // The same generated bitstream still selects each logical half row.
    GatherMask(rawLeft,input,maskA.template ReinterpretCast<uint16_t>(),
     true,(uint32_t)(2*n),{1,1,8,0},retainedA);
    GatherMask(rawRight,input,maskB.template ReinterpretCast<uint16_t>(),
     true,(uint32_t)(2*n),{1,1,8,0},retainedB);
    PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
    Cast(left,rawLeft,RoundMode::CAST_NONE,n);
    Cast(right,rawRight,RoundMode::CAST_NONE,n);
   }
   PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
   Gather(cosPair,cs[(int)(tok-cacheStart)*pitch],pairIndex,0,n);
   Gather(sinPair,sn[(int)(tok-cacheStart)*pitch],pairIndex,0,n);
   PipeBarrier<PIPE_V>();
   SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(0,n);
   FMul(outLeft,left,cosPair,n);FMul(outRight,right,cosPair,n);
   MulAddDst<float,float,false>(outRight,left,sinPair,(uint64_t)0,1,{1,1,1,8,8,8});
   FMuls(sinPair,sinPair,-1.0f,n);
   MulAddDst<float,float,false>(outLeft,right,sinPair,(uint64_t)0,1,{1,1,1,8,8,8});
   PipeBarrier<PIPE_V>();SetMaskNorm();ResetMask();
   LocalTensor<float> packed;
   if constexpr(FP)packed=output.template ReinterpretCast<float>();
   else packed=mem;
   Gather(packed,outLeft,packIndex,0,2*n);PipeBarrier<PIPE_V>();
   SetInputFree(slot);
   if constexpr(!FP)Cast(output,packed,RoundMode::CAST_RINT,2*n);
   SetOutputReady(slot);WaitOutputReady(slot);
   DataCopyExtParams cp{1,(uint32_t)(2*n*sizeof(T)),0,0,0};
   DataCopyPad(gy[(tok*p.heads+h)*2*d],output,cp);SetOutputFree(slot);
  }
  WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
  WaitFlag<HardEvent::V_MTE2>(EVENT_ID2);
  WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);
 }
};


// Host chooses this resource-qualified alternative before launching one kernel.
template<class T,int FixedHalf=0> __global__ __vector__ void rotary_filter_kernel(
 GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){
 if constexpr(FixedHalf>0)p.fullHalf=FixedHalf;
 RopeFilter<T> op;op.Run(x,positions,y,p);
}

template<class T> inline void LaunchRopeFilter(uint32_t cores,aclrtStream stream,GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){
 switch(p.fullHalf){
 case 9:rotary_filter_kernel<T,9><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 10:rotary_filter_kernel<T,10><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 11:rotary_filter_kernel<T,11><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 12:rotary_filter_kernel<T,12><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 13:rotary_filter_kernel<T,13><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 14:rotary_filter_kernel<T,14><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 15:rotary_filter_kernel<T,15><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 default:rotary_filter_kernel<T,0><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 }
}

template<class T> class RopeGather {
 GlobalTensor<T> gx,gy;GlobalTensor<int32_t> gp;
 static constexpr int CAP=2304,POS=CAP/8,IO=2*CAP;
 static constexpr bool FP=sizeof(T)==4;
 static constexpr int WORK=(FP?12:16)*CAP+512;
 static constexpr int INPUT0=POS*4,INPUT1=INPUT0+IO*sizeof(T);
 static constexpr int OUTPUT0=INPUT1+IO*sizeof(T),OUTPUT1=OUTPUT0+IO*sizeof(T);
 static constexpr int WORK_OFFSET=OUTPUT1+IO*sizeof(T);
 __aicore__ inline void SetInputReady(int slot){
  if(slot==0){
   SetFlag<HardEvent::MTE2_V>(EVENT_ID0);
  }else{
   SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
  }
 }
 __aicore__ inline void WaitInputReady(int slot){
  if(slot==0){
   WaitFlag<HardEvent::MTE2_V>(EVENT_ID0);
  }else{
   WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
  }
 }
 __aicore__ inline void SetInputFree(int slot){
  if(slot==0){
   SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }else{
   SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
  }
 }
 __aicore__ inline void WaitInputFree(int slot){
  if(slot==0){
   WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
  }else{
   WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
  }
 }
 __aicore__ inline void SetOutputReady(int slot){
  if(slot==0){
   SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
  }else{
   SetFlag<HardEvent::V_MTE3>(EVENT_ID1);
  }
 }
 __aicore__ inline void WaitOutputReady(int slot){
  if(slot==0){
   WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
  }else{
   WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);
  }
 }
 __aicore__ inline void SetOutputFree(int slot){
  if(slot==0){
   SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }else{
   SetFlag<HardEvent::MTE3_V>(EVENT_ID1);
  }
 }
 __aicore__ inline void WaitOutputFree(int slot){
  if(slot==0){
   WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
  }else{
   WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);
  }
 }
 __aicore__ inline void Load(LocalTensor<T> input,int slot,int64_t off,int count){
  WaitInputFree(slot);
  DataCopyExtParams cp{1,(uint32_t)(count*sizeof(T)),0,0,0};
  DataCopyPadExtParams<T> pad{false,0,0,0};
  DataCopyPad(input,gx[off],cp,pad);
  SetInputReady(slot);
 }
public:
 __aicore__ inline RopeGather(){}
 __aicore__ inline void Run(GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){
 InitSocState();
 const int cap=2304,d=p.fullHalf,csStride=(d+7)/8*8;const bool fp=sizeof(T)==4;
 gx.SetGlobalBuffer((__gm__ T*)x);if(p.bypassX)gx.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);gy.SetGlobalBuffer((__gm__ T*)y);gp.SetGlobalBuffer((__gm__ int32_t*)positions);
 LocalTensor<int32_t> pos(TPosition::VECIN,0,POS);
 LocalTensor<T> input0(TPosition::VECIN,INPUT0,IO),input1(TPosition::VECIN,INPUT1,IO);
 LocalTensor<T> output0(TPosition::VECOUT,OUTPUT0,IO),output1(TPosition::VECOUT,OUTPUT1,IO);
 LocalTensor<float> mem(TPosition::VECCALC,WORK_OFFSET,WORK);
 auto a=mem,rot=mem[2*cap],out=mem[4*cap],expanded=mem[(fp?4:6)*cap],sn=mem[(fp?4:8)*cap],cs=mem[(fp?5:9)*cap],peer=mem[(fp?6:10)*cap],trigidx=mem[(fp?8:12)*cap],sign=mem[(fp?10:14)*cap],inv=mem[(fp?12:16)*cap];
 SetFlag<HardEvent::V_MTE2>(EVENT_ID0);
 SetFlag<HardEvent::V_MTE2>(EVENT_ID1);
 SetFlag<HardEvent::V_MTE2>(EVENT_ID2);
 SetFlag<HardEvent::MTE3_V>(EVENT_ID0);
 SetFlag<HardEvent::MTE3_V>(EVENT_ID1);
 MakeInv(inv,mem,d,p.theta);PipeBarrier<PIPE_V>();
 int ht=RopeHeadTile(p.heads,cap/d,p.tokens);
 int tt=RopeMin(64,cap/(ht*d));if(ht<p.heads)tt=1;tt=RopeMin(tt,(int)((p.tokens+GetBlockNum()-1)/GetBlockNum()));tt=RopeMin(tt,cap/csStride);
 // Balance-aware token tile: keep about BAL tasks per core so a single extra
 // task per core cannot dominate the tail of the kernel.
 {const int BAL=8;int ttBal=(int)((p.tokens+(int64_t)GetBlockNum()*BAL-1)/((int64_t)GetBlockNum()*BAL));if(ttBal<1)ttBal=1;tt=RopeMin(tt,ttBal);}
 int total=2*ht*tt*d;
 // FArange establishes the counter mask once for the index initialization.
 FArange(a,0.0f,1.0f,total);PipeBarrier<PIPE_V>();FMuls(rot,a,1.0f/(float)d,total);PipeBarrier<PIPE_V>();FAdds(rot,rot,0.0001f,total);PipeBarrier<PIPE_V>();FCast(rot.ReinterpretCast<int32_t>(),rot,RoundMode::CAST_FLOOR,total);PipeBarrier<PIPE_V>();
 // Exact -1/+1 orientation from the NPU-generated half-row index.
 FShiftLeft(sign.ReinterpretCast<uint32_t>(),rot.ReinterpretCast<uint32_t>(),(uint32_t)31,total);PipeBarrier<PIPE_V>();
 FAdds(sign.ReinterpretCast<int32_t>(),sign.ReinterpretCast<int32_t>(),(int32_t)0xbf800000,total);PipeBarrier<PIPE_V>();
 FCast(rot,rot.ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,total);PipeBarrier<PIPE_V>();
 FMuls(peer,sign,(float)d,total);FMuls(rot,rot,(float)d,total);PipeBarrier<PIPE_V>();FSub(peer,a,peer,total);FSub(trigidx,a,rot,total);PipeBarrier<PIPE_V>();FMuls(peer,peer,4.0f,total);PipeBarrier<PIPE_V>();FCast(peer.ReinterpretCast<int32_t>(),peer,RoundMode::CAST_RINT,total);
 FMuls(expanded,a,1.0f/(float)(2*d*ht),total);PipeBarrier<PIPE_V>();FAdds(expanded,expanded,0.0001f,total);PipeBarrier<PIPE_V>();FCast(expanded.ReinterpretCast<int32_t>(),expanded,RoundMode::CAST_FLOOR,total);PipeBarrier<PIPE_V>();FCast(expanded,expanded.ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,total);PipeBarrier<PIPE_V>();FMuls(expanded,expanded,(float)csStride,total);PipeBarrier<PIPE_V>();FAdd(trigidx,trigidx,expanded,total);PipeBarrier<PIPE_V>();FMuls(trigidx,trigidx,4.0f,total);PipeBarrier<PIPE_V>();FCast(trigidx.ReinterpretCast<int32_t>(),trigidx,RoundMode::CAST_RINT,total);PipeBarrier<PIPE_V>();
 SetMaskNorm();ResetMask();
 int hb=(p.heads+ht-1)/ht;int64_t tokenTiles=(p.tokens+tt-1)/tt,first=RopeTaskBoundary(tokenTiles,hb,p.tokens,GetBlockIdx()),last=RopeTaskBoundary(tokenTiles,hb,p.tokens,GetBlockIdx()+1),cacheStart=-1,cacheEnd=-1;
 if(first<last){int64_t tok=(first/hb)*tt;int h=(first%hb)*ht;Load(input0,0,(tok*p.heads+h)*2*d,2*RopeMin(tt,(int)(p.tokens-tok))*RopeMin(ht,p.heads-h)*d);}
 for(int64_t task=first;task<last;task++){
  a=mem;rot=mem[(fp?0:2)*cap];out=mem[(fp?2:4)*cap];expanded=mem[(fp?2:6)*cap];
  int64_t tok=(task/hb)*tt;int h=(task%hb)*ht,nt=RopeMin(tt,(int)(p.tokens-tok)),nh=RopeMin(ht,p.heads-h),count=2*nt*nh*d;
  if(tok<cacheStart || tok+nt>cacheEnd){cacheStart=tok;int cc=RopeMin(cap/csStride/tt*tt,(int)(p.tokens-tok));cc=RopeMin(cc,(int)(((last+hb-1)/hb)*tt-tok));cacheEnd=tok+cc;
   {
    auto angle=a,q=a[cap],tmp=out;
    const int64_t token=tok;
    const int count=cc,stride=csStride;
    WaitFlag<HardEvent::V_MTE2>(EVENT_ID2);
    DataCopyExtParams cp{1,(uint32_t)(count*4),0,0,0};
    DataCopyPadExtParams<int32_t> pad{false,0,0,0};
    DataCopyPad(pos,gp[token],cp,pad);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID2);
    // Define the rounded Brcb source lanes on this invocation; Cast replaces valid lanes.
    Duplicate(q,0.0f,(count+7)/8*8);
    PipeBarrier<PIPE_V>();
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID2);
    Cast(q,pos,RoundMode::CAST_NONE,count);
    PipeBarrier<PIPE_V>();
    SetFlag<HardEvent::V_MTE2>(EVENT_ID2);
 Brcb(tmp,q,(count+7)/8,{1,8});PipeBarrier<PIPE_V>();
 if(stride==8 && count>=8 && (count&7)==0){
  Mul(angle,inv,tmp,64,count/8,{1,0,1,8,0,8});
 }else{
 BinaryRepeatParams br{1,1,0,(uint8_t)(stride/8),0,1};
 for(int begin=0;begin<count;begin+=255){int repeats=RopeMin(255,count-begin);for(int j=0;j<stride;j+=64)Mul(angle[begin*stride+j],inv[j],tmp[begin*8],RopeMin(64,stride-j),repeats,br);}
 }
 PipeBarrier<PIPE_V>();
   }Trig(a,a[cap],out,a,out,sn,cs,cc*csStride);
  }
  int64_t off=(tok*p.heads+h)*2*d;
  const int slot=(int)((task-first)&1);
  auto input=slot==0?input0:input1;
  WaitInputReady(slot);
  if(task+1<last){int64_t nextTok=((task+1)/hb)*tt;int nextH=((task+1)%hb)*ht;auto nextInput=slot==0?input1:input0;Load(nextInput,slot^1,(nextTok*p.heads+nextH)*2*d,2*RopeMin(tt,(int)(p.tokens-nextTok))*RopeMin(ht,p.heads-nextH)*d);}
  WaitOutputFree(slot);
  auto output=slot==0?output0:output1;
  if constexpr(sizeof(T)==2)Cast(a,input,RoundMode::CAST_NONE,count);else{a=input.template ReinterpretCast<float>();out=output.template ReinterpretCast<float>();}
  // The whole task body below is one in-order vector chain; the flag issued
  // after it (SetInputFree) is the only cross-pipe handoff and orders itself.
  Gather(rot,a,peer.ReinterpretCast<uint32_t>(),0,count);Gather(expanded,cs[(int)(tok-cacheStart)*csStride],trigidx.ReinterpretCast<uint32_t>(),0,count);Mul(out,a,expanded,count);
  Gather(expanded,sn[(int)(tok-cacheStart)*csStride],trigidx.ReinterpretCast<uint32_t>(),0,count);Mul(expanded,expanded,sign,count);MulAddDst(out,rot,expanded,count);PipeBarrier<PIPE_V>();SetInputFree(slot);
  if constexpr(sizeof(T)==2)Cast(output,out,RoundMode::CAST_RINT,count);SetOutputReady(slot);WaitOutputReady(slot);DataCopyExtParams cp{1,(uint32_t)(count*sizeof(T)),0,0,0};DataCopyPad(gy[off],output,cp);SetOutputFree(slot);
 }
 WaitFlag<HardEvent::V_MTE2>(EVENT_ID0);
 WaitFlag<HardEvent::V_MTE2>(EVENT_ID1);
 WaitFlag<HardEvent::V_MTE2>(EVENT_ID2);
 WaitFlag<HardEvent::MTE3_V>(EVENT_ID0);
 WaitFlag<HardEvent::MTE3_V>(EVENT_ID1);
 }
};


// Float nonaligned rows: use complete aligned head groups for continuous input,
// then form two aligned UB planes and interleave their exact logical GM writes.
__aicore__ inline int RopeLongAxisGroup(int d){
 int group=1;while(((2*d*group)&7)!=0)group*=2;return group;
}
__aicore__ inline bool UseRopeLongAxis(const RopeParams& p,GM_ADDR x,GM_ADDR y){
 const int d=p.fullHalf,cores=(int)GetBlockNum();
 if(d<=0 || d>=128 || (d&7)==0 || p.heads<=1 || p.tokens<=0 || cores<=0)return false;
 if((reinterpret_cast<uintptr_t>(x)&31u)!=0u ||
    (reinterpret_cast<uintptr_t>(y)&31u)!=0u)return false;
 const int pitch=(d+7)/8*8,group=RopeLongAxisGroup(d);
 if(p.heads%group!=0)return false;
 const int newHt=RopeMin(255,3072/pitch)/group*group;
 if(newHt<group || newHt>255)return false;
 // Retain the original Gather route unless it already uses one token per tile.
 const int oldCap=2304;
 int oldHt=RopeMin(p.heads,oldCap/d);
 if(p.tokens<cores){
  const int fanout=(cores+(int)p.tokens-1)/(int)p.tokens;
  const int fit=p.heads/fanout;
  oldHt=RopeMin(oldHt,fit>0?fit:1);
 }
 int oldTt=RopeMin(64,oldCap/(oldHt*d));
 if(oldHt<p.heads)oldTt=1;
 oldTt=RopeMin(oldTt,(int)((p.tokens+cores-1)/cores));
 oldTt=RopeMin(oldTt,oldCap/pitch);
 return oldTt==1;
}
class RopeLongAxis {
 TPipe& pipe;
 TQue<QuePosition::VECIN,2> qi;
 TQue<QuePosition::VECIN,1> qp;
 TQue<QuePosition::VECOUT,2> qo;
 TBuf<QuePosition::VECCALC> buf;
 GlobalTensor<float> gx,gy;
 GlobalTensor<int32_t> gp;
 static constexpr int CAP=3072;
 __aicore__ inline void Load(int64_t off,int count){
  auto input=qi.AllocTensor<float>();
  DataCopyExtParams cp{1,(uint32_t)(count*4),0,0,0};
  DataCopyPadExtParams<float> pad{true,0,(uint8_t)((8-count%8)%8),0.0f};
  DataCopyPad(input,gx[off],cp,pad);qi.EnQue(input);
 }
public:
 __aicore__ inline RopeLongAxis(TPipe& p):pipe(p){}
 __aicore__ inline void Run(GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){
  const int d=p.fullHalf,pitch=(d+7)/8*8,group=RopeLongAxisGroup(d);
  int ht=RopeMin(p.heads,RopeMin(255,CAP/pitch)/group*group);
  if(p.tokens<GetBlockNum()){
   const int fanout=(int)((GetBlockNum()+p.tokens-1)/p.tokens);
   const int headGroups=p.heads/group;
   const int fitGroups=headGroups/fanout;
   ht=RopeMin(ht,(fitGroups>0?fitGroups:1)*group);
  }
  const int hb=(p.heads+ht-1)/ht,indexCount=ht*pitch;
  gx.SetGlobalBuffer((__gm__ float*)x);if(p.bypassX)gx.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
  gy.SetGlobalBuffer((__gm__ float*)y);gp.SetGlobalBuffer((__gm__ int32_t*)positions);
  // 32*CAP IO + 28*CAP workspace + CAP/2 positions + 2048 inv = 187904 B.
  pipe.InitBuffer(qp,1,CAP/8*4);
  pipe.InitBuffer(qi,2,2*CAP*4);pipe.InitBuffer(qo,2,2*CAP*4);
  pipe.InitBuffer(buf,(7*CAP+512)*4);
  auto mem=buf.Get<float>(),a=mem,b=mem[CAP],idxA=mem[2*CAP],idxB=mem[3*CAP];
  auto neg=mem[4*CAP],sn=mem[5*CAP],cs=mem[6*CAP],inv=mem[7*CAP];
  const int64_t first=RopeTaskBoundary(p.tokens,hb,p.tokens,GetBlockIdx());
  const int64_t last=RopeTaskBoundary(p.tokens,hb,p.tokens,GetBlockIdx()+1);
  if(first<last){
   const int64_t tok=first/hb;const int h=(int)(first%hb)*ht;
   Load((tok*p.heads+h)*2*d,2*RopeMin(ht,p.heads-h)*d);
  }
  MakeInv(inv,mem,d,p.theta);PipeBarrier<PIPE_V>();
  // NPU-generated layout indices. Every padding lane selects a real element.
  // indexCount<=3072 and pitch<=128 bound the floor-bias index construction.
  FArange(a,0.0f,1.0f,indexCount);PipeBarrier<PIPE_V>();
  FMuls(b,a,1.0f/(float)pitch,indexCount);PipeBarrier<PIPE_V>();
  FAdds(b,b,0.0001f,indexCount);PipeBarrier<PIPE_V>();
  FCast(b.ReinterpretCast<int32_t>(),b,RoundMode::CAST_FLOOR,indexCount);PipeBarrier<PIPE_V>();
  FCast(b,b.ReinterpretCast<int32_t>(),RoundMode::CAST_NONE,indexCount);PipeBarrier<PIPE_V>();
  FMuls(idxA,b,(float)(2*d),indexCount);PipeBarrier<PIPE_V>();
  FMuls(b,b,(float)pitch,indexCount);PipeBarrier<PIPE_V>();
  FSub(a,a,b,indexCount);PipeBarrier<PIPE_V>();
  SetMaskNorm();ResetMask();
  Mins(a,a,(float)(d-1),indexCount);PipeBarrier<PIPE_V>();
  Add(idxA,idxA,a,indexCount);PipeBarrier<PIPE_V>();
  Muls(idxA,idxA,4.0f,indexCount);PipeBarrier<PIPE_V>();
  Adds(idxB,idxA,(float)(4*d),indexCount);PipeBarrier<PIPE_V>();
  Cast(idxA.ReinterpretCast<int32_t>(),idxA,RoundMode::CAST_RINT,indexCount);
  Cast(idxB.ReinterpretCast<int32_t>(),idxB,RoundMode::CAST_RINT,indexCount);
  PipeBarrier<PIPE_V>();
  int64_t cacheStart=-1,cacheEnd=-1;
  for(int64_t task=first;task<last;task++){
   const int64_t tok=task/hb;const int h=(int)(task%hb)*ht;
   const int nh=RopeMin(ht,p.heads-h),planeCount=nh*pitch;
   if(tok<cacheStart || tok+1>cacheEnd){
    cacheStart=tok;
    int cc=RopeMin(CAP/pitch,(int)(p.tokens-tok));
    cc=RopeMin(cc,(int)((last+hb-1)/hb-tok));cacheEnd=tok+cc;
    // Initialize the rounded Brcb source lanes before the valid position Cast.
    PipeBarrier<PIPE_V>();Duplicate(b,0.0f,(cc+7)/8*8);PipeBarrier<PIPE_V>();
    RopeAngles(qp,gp,a,b,neg,inv,tok,cc,pitch);
    Trig(a,b,neg,a,neg,sn,cs,cc*pitch);PipeBarrier<PIPE_V>();
    Muls(neg,sn,-1.0f,cc*pitch);PipeBarrier<PIPE_V>();
   }
   const int64_t off=(tok*p.heads+h)*2*d;
   auto input=qi.DeQue<float>();
   if(task+1<last){
    const int64_t nextTok=(task+1)/hb;const int nextH=(int)((task+1)%hb)*ht;
    Load((nextTok*p.heads+nextH)*2*d,2*RopeMin(ht,p.heads-nextH)*d);
   }
   auto output=qo.AllocTensor<float>(),u=output,v=output[CAP];
   Gather(a,input,idxA.ReinterpretCast<uint32_t>(),0,planeCount);
   Gather(b,input,idxB.ReinterpretCast<uint32_t>(),0,planeCount);
   Duplicate(u,0.0f,planeCount);Duplicate(v,0.0f,planeCount);PipeBarrier<PIPE_V>();
   qi.FreeTensor(input);
   const int c=(int)(tok-cacheStart)*pitch;
   BinaryRepeatParams br{1,1,1,(uint8_t)(pitch/8),(uint8_t)(pitch/8),0};
   for(int j=0;j<d;j+=64){
    const int mask=RopeMin(64,d-j);
    Mul(u[j],a[j],cs[c+j],mask,nh,br);Mul(v[j],b[j],cs[c+j],mask,nh,br);
   }
   PipeBarrier<PIPE_V>();
   for(int j=0;j<d;j+=64){
    const int mask=RopeMin(64,d-j);
    MulAddDst(u[j],b[j],neg[c+j],mask,nh,br);
    MulAddDst(v[j],a[j],sn[c+j],mask,nh,br);
   }
   PipeBarrier<PIPE_V>();qo.EnQue(output);output=qo.DeQue<float>();
   DataCopyExtParams cp{(uint16_t)nh,(uint32_t)(d*4),0,(uint32_t)(d*4),0};
   DataCopyPad(gy[off],output,cp);DataCopyPad(gy[off+d],output[CAP],cp);
   qo.FreeTensor(output);
  }
 }
};

// Small tensors have little arithmetic per core. Keep the complete token in one
// compact allocation and avoid queue and gather-index setup. All positions and
// input values are still loaded from GM on every invocation.
template<class T, int FixedHalf=0> class RopeSmall {
 GlobalTensor<T> gx, gy;
 GlobalTensor<int32_t> gp;
public:
 __aicore__ inline void Run(GM_ADDR x, GM_ADDR positions, GM_ADDR y,
                           RopeParams p) {
  const int d=FixedHalf>0?FixedHalf:p.fullHalf;
  const int stride=(d+15)/16*16;
  const int ioStride=(d*sizeof(T)+31)/32*32/sizeof(T);
  InitSocState();
  // Short-axis budgets for halfDim up to 64: inverse scratch in [0,832)
  // reused afterwards by the 7x64 trig scratch, then one token of padded IO
  // per half of the window plus a small FP16 staging strip.
  LocalTensor<float> mem(TPosition::VECCALC,0,6272);
  auto angle=mem[0],q=mem[64],t=mem[128],red=mem[192];
  auto square=mem[256],sn=mem[320],cs=mem[384],tmp=mem[448];
  auto inv=mem[1024];
  auto input=mem[1088].template ReinterpretCast<T>();
  auto output=mem[3136].template ReinterpretCast<T>();
  auto a=mem[5184],u=output.template ReinterpretCast<float>();
  auto b=a[64],v=u[64];
  auto pos=mem[6208].template ReinterpretCast<int32_t>();
  gx.SetGlobalBuffer((__gm__ T*)x);if(p.bypassX)gx.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
  gy.SetGlobalBuffer((__gm__ T*)y);
  gp.SetGlobalBuffer((__gm__ int32_t*)positions);
  // Host dispatch guarantees one token for every launched vector core.
  const uint32_t token=(uint32_t)GetBlockIdx();
  DataCopyExtParams cp{(uint16_t)(2*p.heads),(uint32_t)(d*sizeof(T)),0,0,0};
  DataCopyPadExtParams<T> pad{false,0,0,(T)0};
  {
   const int64_t off=(int64_t)(token*(uint32_t)p.heads*2u*(uint32_t)d);
   DataCopyPad(input,gx[off],cp,pad);
   DataCopyExtParams pc{1,4,0,0,0};
   DataCopyPadExtParams<int32_t> pp{false,0,0,0};
   DataCopyPad(pos,gp[(int64_t)token],pc,pp);
   // Order both input copies (MTE2) before the vector reads with an explicit
   // event instead of stalling the whole pipeline.
   SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
   // MakeInv already routes halfDim 8..16 (in-range theta) to the scalar
   // double-float ratio chain, which reaches the same values without the
   // power-of-two sqrt ladder's per-stage vector<->scalar round trips.
   MakeInv(inv,mem,d,p.theta);
   WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
   Cast(q,pos,RoundMode::CAST_NONE,1);
   Brcb(t,q,1,{1,8});
   Mul(angle,inv,t,d,1,{1,1,0,8,8,0});
   Trig(angle,q,t,red,square,sn,cs,stride);
   Muls(tmp,sn,-1.0f,stride);
   // The DMA already gives every half dimension its aligned UB slot.
   // Operate directly in that layout: no gather and no per-head local copies.
   const int elements=2*p.heads*ioStride;
   if constexpr(sizeof(T)==2) {
    Cast(a,input,RoundMode::CAST_NONE,elements);
   } else {
    a=input.template ReinterpretCast<float>();
    u=output.template ReinterpretCast<float>();
   }
   b=a[ioStride];v=u[ioStride];
   BinaryRepeatParams br{1,1,1,(uint8_t)(2*ioStride/8),(uint8_t)(2*ioStride/8),0};
   Mul(u,a,cs,d,2*p.heads,{1,1,1,(uint8_t)(ioStride/8),(uint8_t)(ioStride/8),0});
   PipeBarrier<PIPE_V>();
   MulAddDst(u,b,tmp,d,p.heads,br);MulAddDst(v,a,sn,d,p.heads,br);
   if constexpr(sizeof(T)==2) {
    PipeBarrier<PIPE_V>();
    Cast(output,u,RoundMode::CAST_RINT,elements);
   }
   SetFlag<HardEvent::V_MTE3>(EVENT_ID1);
   WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);
   DataCopyPad(gy[off],output,cp);
   // No buffer reuse follows this token; only wait for the final GM store.
   SetFlag<HardEvent::MTE3_S>(EVENT_ID1);
   WaitFlag<HardEvent::MTE3_S>(EVENT_ID1);

  }
 }
};

// Admit a complete core-owned token range only when its padded data fits UB.
inline bool UseRopeOneTile(const RopeParams& p,uint32_t cores,int elementBytes){
 constexpr int CAP=512;
 if(p.tokens<=0 || p.tokens>UINT32_MAX || p.heads<=0 || p.fullHalf<=0 || p.fullHalf>CAP ||
    cores==0 || cores>65535u || (int64_t)cores>p.tokens)return false;
 const int alignment=32/elementBytes;
 const int pitch=(p.fullHalf+alignment-1)/alignment*alignment;
 const int64_t tokenPairs=(int64_t)p.heads*pitch;
 if(tokenPairs>CAP)return false;
 const int64_t maxTokens=(p.tokens-1)/cores+1;
 return maxTokens<=CAP/tokenPairs &&
        ((int64_t)p.heads*2*p.fullHalf*elementBytes)%32==0;
}

// All inverse frequencies and trigonometric values are generated each call.
// The former inverse scratch becomes rotation/trig scratch after its barrier.
template<class T> class RopeOneTile {
 GlobalTensor<T> gx,gy;
 GlobalTensor<int32_t> gp;
 static constexpr int CAP=512,WORK=24*CAP,IO=2*CAP,MAXPOS=CAP/8;
public:
 __aicore__ inline void Run(GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p,
  uint32_t coreTokens,uint32_t tokenRemainder){
  const int d=p.fullHalf;
  const int stride=(d+7)/8*8;
  const int ioStride=(d*sizeof(T)+31)/32*32/sizeof(T);
  const uint32_t block=(uint32_t)GetBlockIdx(),coreCount=(uint32_t)GetBlockNum();
  uint32_t firstToken=coreTokens*block,lastToken=firstToken+coreTokens;
  if(tokenRemainder!=0u){
   firstToken+=(tokenRemainder*block)/coreCount;
   lastToken+=(tokenRemainder*(block+1u))/coreCount;
  }
  const int64_t first=(int64_t)firstToken,last=(int64_t)lastToken;
  const int nt=(int)(lastToken-firstToken),posCount=(nt+7)/8*8;
  const int trigCount=nt*stride,elements=2*nt*p.heads*ioStride;
  InitSocState();
  LocalTensor<float> work(TPosition::VECCALC,0,WORK);
  LocalTensor<float> inv(TPosition::VECCALC,WORK*4,CAP);
  LocalTensor<T> input(TPosition::VECIN,(WORK+CAP)*4,IO);
  LocalTensor<T> output(TPosition::VECOUT,(WORK+CAP+IO)*4,IO);
  LocalTensor<int32_t> pos(TPosition::VECIN,(WORK+CAP+2*IO)*4,MAXPOS);
  auto a=work,u=work[2*CAP];
  // Address-only padding: keep each logical trig frame contiguous.
  // The 256-byte gaps use spare WORK space and are never read.
  const int trigPitch=trigCount+64;
  auto angle=work[4*CAP],q=angle[trigPitch],t=q[trigPitch];
  auto red=t[trigPitch],square=red[trigPitch],sn=square[trigPitch];
  auto cs=sn[trigPitch],negSn=cs[trigPitch];
  auto posFloat=negSn[trigPitch],posBroadcast=posFloat[posCount];
  gx.SetGlobalBuffer((__gm__ T*)x);if(p.bypassX)gx.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);gy.SetGlobalBuffer((__gm__ T*)y);
  gp.SetGlobalBuffer((__gm__ int32_t*)positions);
  const int64_t off=(int64_t)(firstToken*(uint32_t)p.heads*2u*(uint32_t)d);
  DataCopyExtParams cp{(uint16_t)(2*nt*p.heads),(uint32_t)(d*sizeof(T)),0,0,0};
  DataCopyPadExtParams<T> pad{true,0,(uint8_t)(ioStride-d),(T)0};
  DataCopyPad(input,gx[off],cp,pad);
  DataCopyExtParams pc{1,(uint32_t)(nt*4),0,0,0};
  DataCopyPadExtParams<int32_t> pp{true,0,(uint8_t)(posCount-nt),0};
  DataCopyPad(pos,gp[first],pc,pp);
  MakeInv(inv,work,d,p.theta);PipeBarrier<PIPE_V>();
  SetFlag<HardEvent::MTE2_V>(EVENT_ID1);
  WaitFlag<HardEvent::MTE2_V>(EVENT_ID1);
  Cast(posFloat,pos,RoundMode::CAST_NONE,posCount);PipeBarrier<PIPE_V>();
  Brcb(posBroadcast,posFloat,(uint8_t)(posCount/8),{1,8});PipeBarrier<PIPE_V>();
  BinaryRepeatParams angleBr{1,1,0,(uint8_t)(stride/8),0,1};
  if(stride==8 && nt>=8 && (nt&7)==0){
   Mul(angle,inv,posBroadcast,64,nt/8,{1,0,1,8,0,8});
  }else{
  for(int j=0;j<stride;j+=64)
   Mul(angle[j],inv[j],posBroadcast,RopeMin(64,stride-j),nt,angleBr);
  }
  PipeBarrier<PIPE_V>();
  Trig(angle,q,t,red,square,sn,cs,trigCount);
  Muls(negSn,sn,-1.0f,trigCount);PipeBarrier<PIPE_V>();
  if constexpr(sizeof(T)==2)Cast(a,input,RoundMode::CAST_NONE,elements);
  else{a=input.template ReinterpretCast<float>();u=output.template ReinterpretCast<float>();}
  // Explicitly define every output padding lane before the final whole-row cast.
  Duplicate(u,0.0f,elements);PipeBarrier<PIPE_V>();
  const bool repeatTokens=nt>p.heads;
  const bool packedFrequency=(d%8)==0 && stride<=16;
  const int tokenStep=2*p.heads*ioStride,headStep=2*ioStride;
  const bool packedTokens=packedFrequency && repeatTokens && nt>=8 && (nt&7)==0 && tokenStep<=255;
  const bool packedHeads=packedFrequency && !repeatTokens && p.heads>=8 && (p.heads&7)==0 && headStep<=255;
  // Materialize a current-call coefficient only if its copy chain uses fewer
  // vector API issues than the existing per-axis cosine multiplies.
  bool denseCos=false;
  if(ioStride==d && d>=32 && p.heads>1){
   int copySteps=0;
   for(int filled=1;filled<p.heads;filled*=2)++copySteps;
   const int oldCosCalls=2*(repeatTokens?p.heads:nt)*((d+63)/64);
   denseCos=oldCosCalls>nt*(2+copySteps)+1;
  }
  if(denseCos){
   // The bank-padded trig and position region ends below work[7232].
   // At most IO floats are written here; the inverse scratch is already dead.
   auto fullCos=work[8192];
   for(int row=0;row<nt;row++){
    const int o=2*row*p.heads*d,c=row*stride;
    Muls(fullCos[o],cs[c],1.0f,d);
    Muls(fullCos[o+d],cs[c],1.0f,d);
    PipeBarrier<PIPE_V>();
    for(int filled=1;filled<p.heads;filled*=2){
     const int copies=RopeMin(filled,p.heads-filled);
     Muls(fullCos[o+2*filled*d],fullCos[o],1.0f,2*copies*d);
     PipeBarrier<PIPE_V>();
    }
   }
   Mul(u,a,fullCos,elements);
  }
  if(packedTokens || packedHeads){
   const int packedOuter=packedTokens?p.heads:nt;
   const int packedGroups=(packedTokens?nt:p.heads)/8;
   const int packedDataStep=packedTokens?tokenStep:headStep;
   const int packedCoeffBlock=packedTokens?stride/8:0;
   const int packedCoeffRepeat=packedTokens?stride:0;
   BinaryRepeatParams packedBr{(uint8_t)(packedDataStep/8),(uint8_t)(packedDataStep/8),(uint8_t)packedCoeffBlock,
    (uint8_t)packedDataStep,(uint8_t)packedDataStep,(uint8_t)packedCoeffRepeat};
   for(int row=0;row<packedOuter;row++)for(int j=0;j<d;j+=8){
    const int o=2*row*(packedTokens?1:p.heads)*ioStride+j;
    const int c=(packedTokens?0:row)*stride+j;
    Mul(u[o],a[o],cs[c],64,packedGroups,packedBr);
    Mul(u[o+ioStride],a[o+ioStride],cs[c],64,packedGroups,packedBr);
   }
   PipeBarrier<PIPE_V>();
   for(int row=0;row<packedOuter;row++)for(int j=0;j<d;j+=8){
    const int o=2*row*(packedTokens?1:p.heads)*ioStride+j;
    const int c=(packedTokens?0:row)*stride+j;
    MulAddDst(u[o],a[o+ioStride],negSn[c],64,packedGroups,packedBr);
    MulAddDst(u[o+ioStride],a[o],sn[c],64,packedGroups,packedBr);
   }
  }else{
  const int outer=repeatTokens?p.heads:nt;
  const int repeats=repeatTokens?nt:p.heads;
  const int dataRepeat=(repeatTokens?2*p.heads*ioStride:2*ioStride)/8;
  const int trigRepeat=repeatTokens?stride/8:0;
  BinaryRepeatParams br{1,1,1,(uint8_t)dataRepeat,(uint8_t)dataRepeat,(uint8_t)trigRepeat};
  if(!denseCos){
  for(int row=0;row<outer;row++)for(int j=0;j<d;j+=64){
   const int o=2*row*(repeatTokens?1:p.heads)*ioStride+j;
   const int c=(repeatTokens?0:row)*stride+j,m=RopeMin(64,d-j);
   Mul(u[o],a[o],cs[c],m,repeats,br);
   Mul(u[o+ioStride],a[o+ioStride],cs[c],m,repeats,br);
  }
  }
  PipeBarrier<PIPE_V>();
  for(int row=0;row<outer;row++)for(int j=0;j<d;j+=64){
   const int o=2*row*(repeatTokens?1:p.heads)*ioStride+j;
   const int c=(repeatTokens?0:row)*stride+j,m=RopeMin(64,d-j);
   MulAddDst(u[o],a[o+ioStride],negSn[c],m,repeats,br);
   MulAddDst(u[o+ioStride],a[o],sn[c],m,repeats,br);
  }
  }
  PipeBarrier<PIPE_V>();
  if constexpr(sizeof(T)==2)Cast(output,u,RoundMode::CAST_RINT,elements);
  SetFlag<HardEvent::V_MTE3>(EVENT_ID1);
  WaitFlag<HardEvent::V_MTE3>(EVENT_ID1);
  DataCopyPad(gy[off],output,cp);
  SetFlag<HardEvent::MTE3_S>(EVENT_ID1);
  WaitFlag<HardEvent::MTE3_S>(EVENT_ID1);

 }
};
template<class T> __global__ __vector__ void rotary_one_tile_kernel(
 GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p,uint32_t coreTokens,uint32_t tokenRemainder){
 RopeOneTile<T> op;op.Run(x,positions,y,p,coreTokens,tokenRemainder);
}

class RopeFlatHalf {
 TPipe& pipe;
 TQueBind<QuePosition::VECIN,QuePosition::VECOUT,2> qio;
 TQue<QuePosition::VECIN,1> qp;
 TBuf<QuePosition::VECCALC> buf;
 GlobalTensor<half> gx,gy;
 GlobalTensor<int32_t> gp;
 static constexpr int CAP=5136,CACHE=4112;
 int d,heads;
 __aicore__ inline LocalTensor<half> Fetch(int64_t row,int nr){
  auto v=qio.AllocTensor<half>();
  DataCopy(v,gx[row*2*d],nr*2*d);
  return v;
 }
 __aicore__ inline void Load(int64_t row,int nr){
  auto v=Fetch(row,nr);qio.EnQue<QuePosition::GM,QuePosition::VECIN,half>(v);
 }
 template<bool Finish> __aicore__ inline void Rotate(LocalTensor<float> u,LocalTensor<float> a,
   LocalTensor<float> cs,LocalTensor<float> sn,LocalTensor<float> neg,int64_t token,int h,int nr,int nt,int64_t cacheStart){
  const bool repeatTokens=nt>heads && 2*heads*d/8<=255;
  if(repeatTokens){
   BinaryRepeatParams br{1,1,1,(uint8_t)(2*heads*d/8),(uint8_t)(2*heads*d/8),(uint8_t)(d/8)};
   for(int i=0;i<heads;i++)for(int j=0;j<d;j+=64){
    int o=2*i*d+j,c=(int)(token-cacheStart)*d+j,m=RopeMin(64,d-j);
    if constexpr(!Finish){Mul(u[o],a[o],cs[c],m,nt,br);Mul(u[o+d],a[o+d],cs[c],m,nt,br);}
    else{MulAddDst(u[o],a[o+d],neg[c],m,nt,br);MulAddDst(u[o+d],a[o],sn[c],m,nt,br);}
   }
  }else{
   BinaryRepeatParams br{1,1,1,(uint8_t)(2*d/8),(uint8_t)(2*d/8),0};
   int done=0;
   while(done<nr){
    int take=RopeMin(nr-done,heads-h);
    for(int j=0;j<d;j+=64){
     int o=2*done*d+j,c=(int)(token-cacheStart)*d+j,m=RopeMin(64,d-j);
     if constexpr(!Finish){Mul(u[o],a[o],cs[c],m,take,br);Mul(u[o+d],a[o+d],cs[c],m,take,br);}
     else{MulAddDst(u[o],a[o+d],neg[c],m,take,br);MulAddDst(u[o+d],a[o],sn[c],m,take,br);}
    }
    done+=take;token++;h=0;
   }
  }
 }
public:
 __aicore__ inline RopeFlatHalf(TPipe& p):pipe(p){}
 __aicore__ inline void Run(GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){
  d=p.fullHalf;heads=p.heads;
  gx.SetGlobalBuffer((__gm__ half*)x);if(p.bypassX)gx.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);gy.SetGlobalBuffer((__gm__ half*)y);gp.SetGlobalBuffer((__gm__ int32_t*)positions);
  pipe.InitBuffer(qio,3,2*CAP*sizeof(half));pipe.InitBuffer(qp,1,(CACHE/64*4+31)/32*32);
  pipe.InitBuffer(buf,(4*CAP+3*CACHE+512)*4);
  auto mem=buf.Get<float>(),a=mem,q=mem[CAP],u=mem[2*CAP],neg=mem[4*CAP],sn=mem[4*CAP+CACHE],cs=mem[4*CAP+2*CACHE],inv=mem[4*CAP+3*CACHE];
  int ht=CAP/d,tt=0;if(heads<=ht){tt=ht/heads;ht=tt*heads;}const int cacheTokens=CACHE/d;
  const int tokenTile=tt>0?tt:1,hb=tt>0?1:(heads+ht-1)/ht;
  const int64_t groups=(p.tokens+tokenTile-1)/tokenTile;
  const int64_t first=RopeTaskBoundary(groups,hb,p.tokens,GetBlockIdx()),last=RopeTaskBoundary(groups,hb,p.tokens,GetBlockIdx()+1);
  int64_t coreTokenEnd=(last+hb-1)/hb*tokenTile;if(coreTokenEnd>p.tokens)coreTokenEnd=p.tokens;
  int64_t cacheStart=-1,cacheEnd=-1;
  if(first<last){const int64_t tok=(first/hb)*tokenTile;const int h=(int)(first%hb)*ht;
   const int nr=tt>0?RopeMin(tt,(int)(p.tokens-tok))*heads:RopeMin(ht,heads-h);Load(tok*heads+h,nr);}
  MakeInv(inv,mem,d,p.theta);PipeBarrier<PIPE_V>();
  for(int64_t task=first;task<last;task++){
   const int64_t token=(task/hb)*tokenTile;const int h=(int)(task%hb)*ht;
   const int64_t row=token*heads+h;const int nt=tt>0?RopeMin(tt,(int)(p.tokens-token)):0;
   const int nr=tt>0?nt*heads:RopeMin(ht,heads-h),count=nr*d;
   const int64_t tokenEnd=tt>0?token+nt:token+1;
   if(token<cacheStart || tokenEnd>cacheEnd){
    cacheStart=token;
    cacheEnd=token+(cacheTokens/tokenTile)*tokenTile;if(cacheEnd>coreTokenEnd)cacheEnd=coreTokenEnd;int cc=(int)(cacheEnd-cacheStart);
    RopeAngles(qp,gp,a,q,neg,inv,cacheStart,cc,d);
    Trig(a,q,neg,a,neg,sn,cs,cc*d);Muls(neg,sn,-1.0f,cc*d);PipeBarrier<PIPE_V>();
   }
   auto input=qio.DeQue<QuePosition::GM,QuePosition::VECIN,half>();
   LocalTensor<half> nextInput;const bool hasNext=task+1<last;
   if(hasNext){const int64_t nextTok=((task+1)/hb)*tokenTile;const int nextH=(int)((task+1)%hb)*ht;
    const int nextNt=tt>0?RopeMin(tt,(int)(p.tokens-nextTok)):0,nextNr=tt>0?nextNt*heads:RopeMin(ht,heads-nextH);
    nextInput=Fetch(nextTok*heads+nextH,nextNr);}
   Cast(a,input,RoundMode::CAST_NONE,2*count);
   Rotate<false>(u,a,cs,sn,neg,token,h,nr,nt,cacheStart);
   Rotate<true>(u,a,cs,sn,neg,token,h,nr,nt,cacheStart);PipeBarrier<PIPE_V>();
   Cast(input,u,RoundMode::CAST_RINT,2*count);
   qio.EnQue<QuePosition::VECOUT,QuePosition::GM,half>(input);
   if(hasNext)qio.EnQue<QuePosition::GM,QuePosition::VECIN,half>(nextInput);
   auto output=qio.DeQue<QuePosition::VECOUT,QuePosition::GM,half>();
   DataCopy(gy[row*2*d],output,2*count);qio.FreeTensor(output);
  }
 }
};

__global__ __vector__ void rotary_flat_half_kernel(GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){TPipe pipe;RopeFlatHalf op(pipe);op.Run(x,positions,y,p);}


// FP32 aligned axis/resource path: three IO slots and one packed rotation temp.
// Each IO slot retains ownership until its MTE3 store has been submitted/freed.
template<int FixedHalf=0> class RopeBatchTK2 {
 TPipe& pipe;
 TQueBind<QuePosition::VECIN,QuePosition::VECOUT,2> qio;
 TQue<QuePosition::VECIN,1> qp;
 TBuf<QuePosition::VECCALC> buf;
 GlobalTensor<float> gx,gy;
 GlobalTensor<int32_t> gp;
 // CACHE1920 uses 196480B explicit UB (128B spare); 512B phase alignment is a trial.
 static constexpr int CAP=5568,CACHE=1920;
 __aicore__ inline LocalTensor<float> Fetch(int64_t off,int count){
  auto input=qio.AllocTensor<float>();DataCopy(input,gx[off],count);return input;
 }
 __aicore__ inline void Load(int64_t off,int count){
  auto input=Fetch(off,count);qio.EnQue<QuePosition::GM,QuePosition::VECIN,float>(input);
 }
 template<int Stage> __aicore__ inline void Rotate(LocalTensor<float> input,
  LocalTensor<float> temp,LocalTensor<float> neg,LocalTensor<float> sn,
  LocalTensor<float> cs,int nh,int trigOffset,int d){
  const uint8_t dataStride=(uint8_t)(2*d/8),tempStride=(uint8_t)(d/8);
  BinaryRepeatParams packed{1,1,1,tempStride,dataStride,0};
  BinaryRepeatParams broadcast{1,1,1,dataStride,dataStride,0};
  BinaryRepeatParams finish{1,1,1,dataStride,dataStride,tempStride};
  for(int j=0;j<d;j+=64){
   const int m=RopeMin(64,d-j),c=trigOffset+j;
   if constexpr(Stage==0)Mul(temp[j],input[d+j],neg[c],m,nh,packed);
   else if constexpr(Stage==1)Mul(input[d+j],input[d+j],cs[c],m,nh,broadcast);
   else if constexpr(Stage==2)MulAddDst(input[d+j],input[j],sn[c],m,nh,broadcast);
   else if constexpr(Stage==3)Mul(input[j],input[j],cs[c],m,nh,broadcast);
   else Add(input[j],input[j],temp[j],m,nh,finish);
  }
 }
public:
 __aicore__ inline RopeBatchTK2(TPipe& p):pipe(p){}
 __aicore__ inline void Run(GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){
  const int d=FixedHalf>0?FixedHalf:p.fullHalf;
  gx.SetGlobalBuffer((__gm__ float*)x);if(p.bypassX)gx.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);gy.SetGlobalBuffer((__gm__ float*)y);
  gp.SetGlobalBuffer((__gm__ int32_t*)positions);
  // Choose IO placement by whether one FP32 vector covers the half-row.
  if(d<=64){
   pipe.InitBuffer(qio,3,2*CAP*4);pipe.InitBuffer(qp,1,(CACHE/64*4+31)/32*32);
  }else{
   pipe.InitBuffer(qp,1,(CACHE/64*4+31)/32*32);pipe.InitBuffer(qio,3,2*CAP*4);
  }
  pipe.InitBuffer(buf,(CAP+5*CACHE+512)*4);
  auto mem=buf.Get<float>(),temp=mem,neg=mem[CAP],sn=mem[CAP+CACHE],cs=mem[CAP+2*CACHE],angle=mem[CAP+3*CACHE],q=mem[CAP+4*CACHE],inv=mem[CAP+5*CACHE];
  int ht=RopeMin(RopeHeadTile(p.heads,CAP/d,p.tokens),128);
  // Host selects this path only when HB decreases; that implies ht*d>4096,
  // hence floor(CAP/(ht*d))=1 and the original Batch token tile is exactly 1.
  const int hb=(p.heads+ht-1)/ht;
  const int64_t first=RopeTaskBoundary(p.tokens,hb,p.tokens,GetBlockIdx()),last=RopeTaskBoundary(p.tokens,hb,p.tokens,GetBlockIdx()+1);
  int64_t cacheStart=-1,cacheEnd=-1;
  if(first<last){
   const int64_t tok=first/hb;const int h=(int)(first%hb)*ht;
   Load((tok*p.heads+h)*2*d,2*RopeMin(ht,p.heads-h)*d);
  }
  MakeInv(inv,mem,d,p.theta);PipeBarrier<PIPE_V>();
  for(int64_t task=first;task<last;task++){
   const int64_t tok=task/hb;const int h=(int)(task%hb)*ht;
   const int nh=RopeMin(ht,p.heads-h),count=nh*d;
   if(tok<cacheStart || tok+1>cacheEnd){
    cacheStart=tok;
    int cacheCount=RopeMin(CACHE/d,(int)(p.tokens-tok));
    cacheCount=RopeMin(cacheCount,(int)((last+hb-1)/hb-tok));cacheEnd=tok+cacheCount;
    // Trig scratch is private VECCALC memory; no IO slot is borrowed.
    // Finish the previous rotation readers before updating trig caches.
    RopeAngles(qp,gp,angle,q,neg,inv,tok,cacheCount,d);
    Trig(angle,q,neg,angle,neg,sn,cs,cacheCount*d);
    Muls(neg,sn,-1.0f,cacheCount*d);
    PipeBarrier<PIPE_V>();
   }
   const int64_t off=(tok*p.heads+h)*2*d;
   auto input=qio.DeQue<QuePosition::GM,QuePosition::VECIN,float>();
   LocalTensor<float> nextInput;const bool hasNext=task+1<last;
   if(hasNext){
    const int64_t nextTok=(task+1)/hb;const int nextH=(int)((task+1)%hb)*ht;
    nextInput=Fetch((nextTok*p.heads+nextH)*2*d,2*RopeMin(ht,p.heads-nextH)*d);
   }
   const int c=(int)(tok-cacheStart)*d;
   Rotate<0>(input,temp,neg,sn,cs,nh,c,d);PipeBarrier<PIPE_V>();
   Rotate<1>(input,temp,neg,sn,cs,nh,c,d);PipeBarrier<PIPE_V>();
   Rotate<2>(input,temp,neg,sn,cs,nh,c,d);PipeBarrier<PIPE_V>();
   Rotate<3>(input,temp,neg,sn,cs,nh,c,d);PipeBarrier<PIPE_V>();
   Rotate<4>(input,temp,neg,sn,cs,nh,c,d);
   // One shared FIFO: output must precede the pending next input.
   qio.EnQue<QuePosition::VECOUT,QuePosition::GM,float>(input);
   if(hasNext)qio.EnQue<QuePosition::GM,QuePosition::VECIN,float>(nextInput);
   auto output=qio.DeQue<QuePosition::VECOUT,QuePosition::GM,float>();
   DataCopy(gy[off],output,2*count);qio.FreeTensor(output);
  }
 }
};
template<int FixedHalf=0> __global__ __vector__ void rotary_batch_tk2_float_kernel(
 GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){
 TPipe pipe;RopeBatchTK2<FixedHalf> op(pipe);op.Run(x,positions,y,p);
}

template<class T,int FixedHalf=0> __global__ __vector__ void rotary_kernel(GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){if constexpr(FixedHalf>0)p.fullHalf=FixedHalf;if(p.fullHalf>512){TPipe pipe;RopeWide<T> op(pipe);op.Run(x,positions,y,p);}else if(p.fullHalf%8==0){TPipe pipe;RopeBatch<T> op(pipe);op.Run(x,positions,y,p);}else if((sizeof(T)==2 && p.fullHalf>=64) || p.fullHalf>=128){TPipe pipe;RopePaddedBatch<T> op(pipe);op.Run(x,positions,y,p);}else{if constexpr(sizeof(T)==4){if(UseRopeLongAxis(p,x,y)){TPipe pipe;RopeLongAxis op(pipe);op.Run(x,positions,y,p);}else{RopeGather<T> op;op.Run(x,positions,y,p);}}else{RopeGather<T> op;op.Run(x,positions,y,p);}}}
template<class T>
inline void LaunchRope(uint32_t cores,aclrtStream stream,GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){
 switch(p.fullHalf){
 case 8:rotary_kernel<T,8><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 9:rotary_kernel<T,9><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 10:rotary_kernel<T,10><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 11:rotary_kernel<T,11><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 12:rotary_kernel<T,12><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 13:rotary_kernel<T,13><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 14:rotary_kernel<T,14><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 15:rotary_kernel<T,15><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 16:rotary_kernel<T,16><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 32:rotary_kernel<T,32><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 64:rotary_kernel<T,64><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 128:rotary_kernel<T,128><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 256:rotary_kernel<T,256><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 512:rotary_kernel<T,512><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 default:rotary_kernel<T,0><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 }
}

// ---- Per-head batch path: small heads, 32B-aligned rows, many tokens. ----
// Each head's front/back halves are pulled into packed UB planes with strided
// DataCopyPad (dstStride=0 packs blocks at ceil32(blockLen) = step), so the
// rotation becomes long contiguous count-form ops against per-token cos/sin
// planes. Math is unchanged (same FP32 inv/angle/trig helpers).
template<class T,int FixedHalf=0> class RopeHeadBatch {
 TPipe& pipe;
 TQue<QuePosition::VECIN,2> qa,qb;
 TQue<QuePosition::VECIN,1> qp;
 TQue<QuePosition::VECOUT,2> qo1,qo2;
 TBuf<QuePosition::VECCALC> buf;
 GlobalTensor<T> gx,gy;GlobalTensor<int32_t> gp;
public:
 __aicore__ inline RopeHeadBatch(TPipe& p):pipe(p){}
 __aicore__ inline void Run(GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){
  const int half=FixedHalf>0?FixedHalf:p.fullHalf,D=2*half,heads=p.heads;
  const int maxG=(sizeof(T)==2?3072:2048)/half;
  // The entry and Host predicate admit only fullHalf<=512, tokens>=512.
  // maxG>=4, so this path has no no-output early return.
  const int G=RopeMin(256,maxG);
  const int n=G*half;
  gx.SetGlobalBuffer((__gm__ T*)x);if(p.bypassX)gx.SetL2CacheHint(CacheMode::CACHE_MODE_DISABLE);
  gy.SetGlobalBuffer((__gm__ T*)y);gp.SetGlobalBuffer((__gm__ int32_t*)positions);
  pipe.InitBuffer(qp,1,(G+7)/8*32);
  pipe.InitBuffer(qa,2,G*half*sizeof(T));
  pipe.InitBuffer(qb,2,G*half*sizeof(T));
  pipe.InitBuffer(qo1,2,G*half*sizeof(T));
  pipe.InitBuffer(qo2,2,G*half*sizeof(T));
  pipe.InitBuffer(buf,(9*n+half+128)*4);
  auto mem=buf.Get<float>();
  auto xf=mem,yf=mem[n],uf=mem[2*n],vf=mem[3*n],cosF=mem[4*n],sinF=mem[5*n],negS=mem[6*n],angle=mem[7*n],triq=mem[8*n];
  auto inv=mem[9*n];
  MakeInv(inv,mem,half,p.theta);PipeBarrier<PIPE_V>();
  const int64_t tokens=p.tokens;
  const int64_t per=(tokens+(int64_t)GetBlockNum()-1)/GetBlockNum();
  const int64_t t0=per*GetBlockIdx(),t1=RopeMin(tokens,t0+per);
  for(int64_t tok=t0;tok<t1;tok+=G){
   const int g=RopeMin((int)(t1-tok),G);
   const int m=g*half;
   RopeAngles(qp,gp,angle,triq,negS,inv,tok,g,half);
   Trig(angle,triq,negS,angle,negS,sinF,cosF,m);
   Muls(negS,sinF,-1.0f,m);
   PipeBarrier<PIPE_V>();
   for(int h=0;h<heads;h++){
    const int64_t off=(tok*heads+h)*D;
    auto x1=qa.AllocTensor<T>(),x2=qb.AllocTensor<T>();
    DataCopyExtParams cp{(uint16_t)g,(uint32_t)(half*sizeof(T)),(uint32_t)((int64_t)(heads*D-half)*sizeof(T)),0,0};
    DataCopyPadExtParams<T> pd{false,0,0,(T)0};
    DataCopyPad(x1,gx[off],cp,pd);
    DataCopyPad(x2,gx[off+half],cp,pd);
    qa.EnQue(x1);qb.EnQue(x2);
    x1=qa.DeQue<T>();x2=qb.DeQue<T>();
    auto o1=qo1.AllocTensor<T>(),o2=qo2.AllocTensor<T>();
    LocalTensor<float> A,B,O1,O2;
    if constexpr(sizeof(T)==2){
     A=xf;B=yf;O1=uf;O2=vf;
     Cast(A,x1,RoundMode::CAST_NONE,m);Cast(B,x2,RoundMode::CAST_NONE,m);
    }else{
     A=x1.template ReinterpretCast<float>();B=x2.template ReinterpretCast<float>();
     O1=o1.template ReinterpretCast<float>();O2=o2.template ReinterpretCast<float>();
    }
    SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(0,m);
    Mul<float,false>(O1,A,cosF,(uint64_t)0,1,{1,1,1,8,8,8});
    MulAddDst<float,float,false>(O1,B,negS,(uint64_t)0,1,{1,1,1,8,8,8});
    Mul<float,false>(O2,B,cosF,(uint64_t)0,1,{1,1,1,8,8,8});
    MulAddDst<float,float,false>(O2,A,sinF,(uint64_t)0,1,{1,1,1,8,8,8});
    SetMaskNorm();ResetMask();
    PipeBarrier<PIPE_V>();
    if constexpr(sizeof(T)==2){Cast(o1,O1,RoundMode::CAST_RINT,m);Cast(o2,O2,RoundMode::CAST_RINT,m);}
    qa.FreeTensor(x1);qb.FreeTensor(x2);
    qo1.EnQue(o1);qo2.EnQue(o2);
    o1=qo1.DeQue<T>();o2=qo2.DeQue<T>();
    DataCopyExtParams cw{(uint16_t)g,(uint32_t)(half*sizeof(T)),0,(uint32_t)((int64_t)(heads*D-half)*sizeof(T)),0};
    DataCopyPad(gy[off],o1,cw);
    DataCopyPad(gy[off+half],o2,cw);
    qo1.FreeTensor(o1);qo2.FreeTensor(o2);
   }
  }
 }
};
inline bool UseHeadBatch(const RopeParams& p,uint32_t cores,int64_t totalPairs,int elemBytes){
 if(elemBytes!=4)return false;
 if(p.heads<=0 || p.heads>8 || p.tokens<512 || p.fullHalf<64 || p.fullHalf>512 || cores==0)return false;
 if(((int64_t)p.fullHalf*elemBytes)%32!=0)return false;
 if((int64_t)p.fullHalf*elemBytes<256)return false;
 if(totalPairs<32768)return false;
 if((int64_t)cores>p.tokens)return false;
 return true;
}
template<class T> __global__ __vector__ void rotary_head_batch_kernel(GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){TPipe pipe;if(p.fullHalf>512){RopeWide<T> op(pipe);op.Run(x,positions,y,p);}else{RopeHeadBatch<T> op(pipe);op.Run(x,positions,y,p);}}

template<class T,int FixedHalf=0> __global__ __vector__ void rotary_small_kernel(GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){RopeSmall<T,FixedHalf> op;op.Run(x,positions,y,p);}
template<class T> inline void LaunchSmall(uint32_t cores,aclrtStream stream,GM_ADDR x,GM_ADDR positions,GM_ADDR y,RopeParams p){switch(p.fullHalf){
case 8:rotary_small_kernel<T,8><<<cores,nullptr,stream>>>(x,positions,y,p);break;
case 9:rotary_small_kernel<T,9><<<cores,nullptr,stream>>>(x,positions,y,p);break;
case 10:rotary_small_kernel<T,10><<<cores,nullptr,stream>>>(x,positions,y,p);break;
case 11:rotary_small_kernel<T,11><<<cores,nullptr,stream>>>(x,positions,y,p);break;
case 12:rotary_small_kernel<T,12><<<cores,nullptr,stream>>>(x,positions,y,p);break;
case 13:rotary_small_kernel<T,13><<<cores,nullptr,stream>>>(x,positions,y,p);break;
case 14:rotary_small_kernel<T,14><<<cores,nullptr,stream>>>(x,positions,y,p);break;
case 15:rotary_small_kernel<T,15><<<cores,nullptr,stream>>>(x,positions,y,p);break;
case 16:rotary_small_kernel<T,16><<<cores,nullptr,stream>>>(x,positions,y,p);break;
case 32:rotary_small_kernel<T,32><<<cores,nullptr,stream>>>(x,positions,y,p);break;
default:rotary_small_kernel<T,0><<<cores,nullptr,stream>>>(x,positions,y,p);break;}}
inline int RopeTK2HeadTile(const RopeParams& p,int cap,uint32_t cores){
 int ht=p.heads<cap/p.fullHalf?p.heads:cap/p.fullHalf;
 if(p.tokens<cores){const int fanout=(int)((cores+p.tokens-1)/p.tokens),fit=p.heads/fanout;if(fit<ht)ht=fit>0?fit:1;}
 return ht<128?ht:128;
}
inline bool UseRopeBatchTK2(const RopeParams& p,uint32_t cores,int64_t totalPairs){
 // Resource/dtype dispatch, independent of input contents and complete cases.
 if(p.tokens<=0 || cores==0 || p.fullHalf<64 || p.fullHalf>512 || p.fullHalf%8!=0 || totalPairs<32768)return false;
 // Large fp32 aligned shapes always use the wider tile; smaller ones keep the
 // head-block criterion so that the narrower token-tiled path stays in use
 // where it measured better.
 if(totalPairs>=262144)return true;
 const int oldHt=RopeTK2HeadTile(p,4096,cores),newHt=RopeTK2HeadTile(p,5568,cores);
 const int oldHb=(p.heads+oldHt-1)/oldHt,newHb=(p.heads+newHt-1)/newHt;
 return newHb<oldHb;
}
inline void LaunchRopeBatchTK2(uint32_t cores,aclrtStream stream,GM_ADDR x,
 GM_ADDR positions,GM_ADDR y,RopeParams p){
 switch(p.fullHalf){
 case 64:rotary_batch_tk2_float_kernel<64><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 128:rotary_batch_tk2_float_kernel<128><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 256:rotary_batch_tk2_float_kernel<256><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 case 512:rotary_batch_tk2_float_kernel<512><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 default:rotary_batch_tk2_float_kernel<0><<<cores,nullptr,stream>>>(x,positions,y,p);break;
 }
}


// Integer metadata equivalent of the device LongAxis admission, preserving
// its priority over Filter. No frequency, phase or tensor data is computed.
inline bool RopeHostLongAxis(const RopeParams& p,uint32_t cores,GM_ADDR x,GM_ADDR y){
 const int d=p.fullHalf;
 if(d<=0 || d>=128 || (d&7)==0 || p.heads<=1 || p.tokens<=0 || cores==0)return false;
 if((reinterpret_cast<uintptr_t>(x)&31u)!=0u ||
    (reinterpret_cast<uintptr_t>(y)&31u)!=0u)return false;
 const int pitch=(d+7)/8*8;
 int group=1;while(((2*d*group)&7)!=0)group*=2;
 if(p.heads%group!=0)return false;
 const int raw=3072/pitch;
 const int newHt=(raw<255?raw:255)/group*group;
 if(newHt<group || newHt>255)return false;
 int ht=p.heads<2304/d?p.heads:2304/d;
 if(p.tokens<cores){
  const int fanout=(int)((cores+p.tokens-1)/p.tokens),fit=p.heads/fanout;
  if((fit>0?fit:1)<ht)ht=fit>0?fit:1;
 }
 int tt=2304/(ht*d);if(tt>64)tt=64;
 if(ht<p.heads)tt=1;
 const int per=(int)((p.tokens+cores-1)/cores);
 if(per<tt)tt=per;
 if(2304/pitch<tt)tt=2304/pitch;
 return tt==1;
}
inline bool UseRopeFilterHost(const RopeParams& p,uint32_t cores,
 int64_t pairs,int elementBytes,GM_ADDR x,GM_ADDR y){
 if(p.fullHalf<8 || p.fullHalf>=128 || (p.fullHalf&7)==0 ||
    p.heads<2 || p.tokens<=0 || cores==0 || pairs<32768)return false;
 // Preserve the padded-half and LongAxis algorithms' existing precedence.
 if(elementBytes==2 && p.fullHalf>=64)return false;
 if(elementBytes==4 && RopeHostLongAxis(p,cores,x,y))return false;
 // Amortize mask/index setup over at least eight fully occupied data
 // tiles per core. This is a workload/resource criterion, independent of
 // particular shape tuples, input contents or evaluation stages.
 const int filterTilePairs=elementBytes==4?2560:3072;constexpr int minimumFullTiles=8;
 return pairs>=(int64_t)cores*filterTilePairs*minimumFullTiles;
}

extern "C" void run_kernel(GM_ADDR x,const TensorGroupInfo& info_x,GM_ADDR positions,const TensorGroupInfo& info_positions,GM_ADDR y,const TensorGroupInfo& info_y,int64_t availableCoreNum,aclrtStream stream,float theta){
 const auto shape=info_x.tensors[0].shape;RopeParams p{};p.tokens=shape[0]*shape[1];p.heads=shape[2];p.fullHalf=shape[3]/2;p.theta=theta;
 int64_t targetCores=4,totalPairs=p.tokens*p.heads*p.fullHalf;
 const int elementBytes=info_x.tensors[0].dtype==1?2:4;
 // Model the combined input/output streaming footprint against one budget.
 // Only the input is bypassed; reused coefficients keep their existing policy.
 constexpr int64_t streamWorkingSetBudget=128LL<<20;
 p.bypassX=totalPairs>(streamWorkingSetBudget/(4*elementBytes));
 while(targetCores<availableCoreNum && targetCores*64<totalPairs)targetCores*=2;
 int64_t taskCapacity=p.tokens*p.heads;
 uint32_t cores=(uint32_t)std::min(taskCapacity,std::min(availableCoreNum,targetCores));
 if(info_x.tensors[0].dtype!=1 && p.tokens<(int64_t)cores && p.fullHalf>0 && p.fullHalf<128 && p.fullHalf%8!=0 && p.heads>1 &&
    (reinterpret_cast<uintptr_t>(x)&31u)==0u && (reinterpret_cast<uintptr_t>(y)&31u)==0u){
  int group=1;while(((2*p.fullHalf*group)&7)!=0)group*=2;
  if(p.heads%group==0)cores=(uint32_t)std::min<int64_t>(cores,p.tokens*(p.heads/group));
 }
 const uint32_t tokenCores=(uint32_t)std::min<int64_t>(p.tokens,cores);
 const bool small=p.tokens>0 && p.tokens<=64 && p.tokens<=availableCoreNum && p.heads<=8 && p.fullHalf<=64 && (p.heads==1 || (p.heads*2*p.fullHalf*(info_x.tensors[0].dtype==1?2:4))%32==0);
 if(p.fullHalf>512){
  if(info_x.tensors[0].dtype==1)rotary_wide_kernel<half><<<cores,nullptr,stream>>>(x,positions,y,p);
  else rotary_wide_kernel<float><<<cores,nullptr,stream>>>(x,positions,y,p);
 }else if(small){
  cores=(uint32_t)p.tokens;
  if(info_x.tensors[0].dtype==1)LaunchSmall<half>(cores,stream,x,positions,y,p);
  else LaunchSmall<float>(cores,stream,x,positions,y,p);
 }else if(UseRopeOneTile(p,tokenCores,info_x.tensors[0].dtype==1?2:4)){
  const uint32_t coreTokens=(uint32_t)(p.tokens/tokenCores),tokenRemainder=(uint32_t)(p.tokens%tokenCores);
  if(info_x.tensors[0].dtype==1)rotary_one_tile_kernel<half><<<tokenCores,nullptr,stream>>>(x,positions,y,p,coreTokens,tokenRemainder);
  else rotary_one_tile_kernel<float><<<tokenCores,nullptr,stream>>>(x,positions,y,p,coreTokens,tokenRemainder);
 }else if(UseRopeFilterHost(p,cores,totalPairs,elementBytes,x,y)){
  if(info_x.tensors[0].dtype==1)LaunchRopeFilter<half>(cores,stream,x,positions,y,p);
  else LaunchRopeFilter<float>(cores,stream,x,positions,y,p);
 }else if(info_x.tensors[0].dtype==1){
  if(p.fullHalf>=64 && p.fullHalf%8==0 && p.heads>=2 && p.tokens>32 && totalPairs>=32768){
   int ht=5136/p.fullHalf;if(p.heads<=ht)ht=ht/p.heads*p.heads;
   int64_t tiles=(p.tokens*p.heads+ht-1)/ht;cores=(uint32_t)std::min((int64_t)cores,tiles);
   rotary_flat_half_kernel<<<cores,nullptr,stream>>>(x,positions,y,p);
  }else LaunchRope<half>(cores,stream,x,positions,y,p);
 }else if(UseHeadBatch(p,cores,totalPairs,4))rotary_head_batch_kernel<float><<<cores,nullptr,stream>>>(x,positions,y,p);
 else if(UseRopeBatchTK2(p,cores,totalPairs))LaunchRopeBatchTK2(cores,stream,x,positions,y,p);
 else LaunchRope<float>(cores,stream,x,positions,y,p);
}