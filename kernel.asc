#include <algorithm>
#include <cmath>
#include <cstdint>
#include "kernel_operator.h"
using namespace AscendC;
__aicore__ inline int RopeMin(int a,int b) { return a<b?a:b; }
__aicore__ inline int RopeHeadTile(int heads,int tile,int64_t tokens){
 if(tokens>0 && tokens<GetBlockNum()){
  const int fanout=(int)((GetBlockNum()+tokens-1)/tokens);
  const int fit=heads/fanout;
  tile=RopeMin(tile,fit>0?fit:1);
 }
 return tile<heads?tile:heads;
}
__aicore__ inline int64_t RopeTaskBoundary(int64_t tokenTiles,int headTiles,int64_t tokens,uint32_t boundary){
 const int64_t blocks=GetBlockNum();
 if(tokens<blocks)return tokenTiles*headTiles*boundary/blocks;
 return tokenTiles*boundary/blocks*headTiles;
}
struct RopeParams { int64_t tokens; int32_t heads,bypassX,fullHalf; float theta; };
union RopeBits { float f; uint32_t u; };
template<class T> __aicore__ inline void FAdd(LocalTensor<T> d,LocalTensor<T> a,LocalTensor<T> b,int n){Add<T,false>(d,a,b,(uint64_t)0,1,{1,1,1,8,8,8});}
template<class T> __aicore__ inline void FSub(LocalTensor<T> d,LocalTensor<T> a,LocalTensor<T> b,int n){Sub<T,false>(d,a,b,(uint64_t)0,1,{1,1,1,8,8,8});}
template<class T> __aicore__ inline void FMul(LocalTensor<T> d,LocalTensor<T> a,LocalTensor<T> b,int n){Mul<T,false>(d,a,b,(uint64_t)0,1,{1,1,1,8,8,8});}
template<class T> __aicore__ inline void FDiv(LocalTensor<T> d,LocalTensor<T> a,LocalTensor<T> b,int n){Div<T,false>(d,a,b,(uint64_t)0,1,{1,1,1,8,8,8});}
template<class T> __aicore__ inline void FMuls(LocalTensor<T> d,LocalTensor<T> a,T b,int n){Muls<T,false>(d,a,b,(uint64_t)0,1,{1,1,8,8});}
template<class T> __aicore__ inline void FAdds(LocalTensor<T> d,LocalTensor<T> a,T b,int n){Adds<T,false>(d,a,b,(uint64_t)0,1,{1,1,8,8});}
template<class T> __aicore__ inline void FShiftLeft(LocalTensor<T> d,LocalTensor<T> a,T b,int n){ShiftLeft<T,false>(d,a,b,(uint64_t)0,1,{1,1,8,8});}
template<class T> __aicore__ inline void FDuplicate(LocalTensor<T> d,T v,int n){Duplicate<T,false>(d,v,(uint64_t)0,1,1,8);}
template<class T,class U> __aicore__ inline void FCast(LocalTensor<T> d,LocalTensor<U> s,RoundMode r,int n){Cast<T,U,false>(d,s,r,(uint64_t)0,1,{1,1,8,8});}
__aicore__ inline void FArange(LocalTensor<float> d,float a,float b,int n){
 SetMaskNorm();ResetMask();
 // The DAV-2201 Arange and CreateVecIndex implementations both require TPipe.
 // Seed one block on the device, then expand it with vector Adds.
 SetFlag<HardEvent::V_S>(EVENT_ID2);WaitFlag<HardEvent::V_S>(EVENT_ID2);
 const int seed=RopeMin(8,n);
 for(int i=0;i<seed;i++)d.SetValue(i,a+b*(float)i);
 SetFlag<HardEvent::S_V>(EVENT_ID2);WaitFlag<HardEvent::S_V>(EVENT_ID2);
 for(int filled=8;filled<n;filled*=2){
  Adds(d[filled],d,b*(float)filled,RopeMin(filled,n-filled));
  PipeBarrier<PIPE_V>();
 }
 SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(0,n);
}
struct DF { LocalTensor<float> h,l; };
class DMath {
 LocalTensor<float> t0,t1,t2,t3,t4,t5,t6,t7,t8,t9,t10,t11; int n;
public:
 __aicore__ inline DMath(LocalTensor<float> w,int count):n(count) {t0=w;t1=w[n];t2=w[2*n];t3=w[3*n];t4=w[4*n];t5=w[5*n];t6=w[6*n];t7=w[7*n];t8=w[8*n];t9=w[9*n];t10=w[10*n];t11=w[11*n];}
 __aicore__ inline void cp(LocalTensor<float> a,LocalTensor<float> b){FMuls(a,b,1.0f,n);}
 __aicore__ inline void set(DF d,float h,float l){FDuplicate(d.h,h,n);FDuplicate(d.l,l,n);}
 __aicore__ inline void add(DF d,DF a,DF b){
  FAdd(t0,a.h,b.h,n);FSub(t1,t0,a.h,n);FSub(t2,t0,t1,n);FSub(t3,b.h,t1,n);FSub(t2,a.h,t2,n);FAdd(t3,t2,t3,n);FAdd(t4,a.l,b.l,n);FAdd(t3,t3,t4,n);FAdd(t5,t0,t3,n);FSub(t6,t5,t0,n);FSub(d.l,t3,t6,n);cp(d.h,t5);
 }
 __aicore__ inline void addSmall(DF d,DF a,DF b){FAdd(t0,b.h,a.h,n);FSub(t1,t0,b.h,n);FAdd(t4,a.l,b.l,n);FSub(t2,a.h,t1,n);FAdd(t2,t2,t4,n);FAdd(t5,t0,t2,n);FSub(t6,t5,t0,n);FSub(d.l,t2,t6,n);cp(d.h,t5);}
 // QuickTwoSum for positive exp-Horner stages where the constant exceeds a.h.
 __aicore__ inline void addConst(DF d,DF a,float b){
  FAdds(t0,a.h,b,n);FAdds(t1,t0,-b,n);FSub(t2,a.h,t1,n);FAdd(t2,t2,a.l,n);
  FAdd(d.h,t0,t2,n);FSub(t6,d.h,t0,n);FSub(d.l,t2,t6,n);
 }
 __aicore__ inline void mul(DF d,DF a,DF b){
  FMul(t0,a.h,b.h,n);FMuls(t7,a.h,4097.0f,n);FMuls(t8,b.h,4097.0f,n);FSub(t9,t7,a.h,n);FSub(t10,t8,b.h,n);FSub(t7,t7,t9,n);FSub(t8,t8,t10,n);FSub(t9,a.h,t7,n);FSub(t10,b.h,t8,n);FMul(t2,t7,t8,n);FMul(t1,t7,t10,n);FSub(t2,t2,t0,n);FMul(t11,t9,t8,n);FAdd(t2,t2,t1,n);FMul(t1,t9,t10,n);FAdd(t2,t2,t11,n);FAdd(t2,t2,t1,n);FMul(t3,a.h,b.l,n);FMul(t4,a.l,b.h,n);FAdd(t2,t2,t3,n);FAdd(t2,t2,t4,n);FAdd(d.h,t0,t2,n);FSub(t6,d.h,t0,n);FSub(d.l,t2,t6,n);
 }
 // Bounded Grid2 only. The split factors have at most12 significant
 // bits; their normal-or-zero products are exactly representable in FP32.
 // Retain the separately rounded full product and the same cross-term order.
 __aicore__ inline void mulExactCross(DF d,DF a,DF b){
  FMul(t0,a.h,b.h,n);
  FMuls(t7,a.h,4097.0f,n);FMuls(t8,b.h,4097.0f,n);
  FSub(t9,t7,a.h,n);FSub(t10,t8,b.h,n);
  FSub(t7,t7,t9,n);FSub(t8,t8,t10,n);
  FSub(t9,a.h,t7,n);FSub(t10,b.h,t8,n);
  FMul(t2,t7,t8,n);FSub(t2,t2,t0,n);
  MulAddDst<float,float,false>(t2,t7,t10,(uint64_t)0,1,{1,1,1,8,8,8});
  MulAddDst<float,float,false>(t2,t9,t8,(uint64_t)0,1,{1,1,1,8,8,8});
  MulAddDst<float,float,false>(t2,t9,t10,(uint64_t)0,1,{1,1,1,8,8,8});
  FMul(t3,a.h,b.l,n);FMul(t4,a.l,b.h,n);
  FAdd(t2,t2,t3,n);FAdd(t2,t2,t4,n);
  FAdd(d.h,t0,t2,n);FSub(t6,d.h,t0,n);FSub(d.l,t2,t6,n);
 }
 __aicore__ inline void residualExactCross(LocalTensor<float> d,
  LocalTensor<float> aa,LocalTensor<float> bb,LocalTensor<float> target){
  FMul(t0,aa,bb,n);
  FMuls(t7,aa,4097.0f,n);FMuls(t8,bb,4097.0f,n);
  FSub(t9,t7,aa,n);FSub(t10,t8,bb,n);
  FSub(t7,t7,t9,n);FSub(t8,t8,t10,n);
  FSub(t9,aa,t7,n);FSub(t10,bb,t8,n);
  FMul(t2,t7,t8,n);FSub(t2,t2,t0,n);
  MulAddDst<float,float,false>(t2,t7,t10,(uint64_t)0,1,{1,1,1,8,8,8});
  MulAddDst<float,float,false>(t2,t9,t8,(uint64_t)0,1,{1,1,1,8,8,8});
  MulAddDst<float,float,false>(t2,t9,t10,(uint64_t)0,1,{1,1,1,8,8,8});
  FSub(t0,target,t0,n);FSub(d,t0,t2,n);
 }
 // Same product-error order as mul(a,a), sharing identical split operands.
 __aicore__ inline void square(DF d,DF a){
  FMul(t0,a.h,a.h,n);FMuls(t7,a.h,4097.0f,n);FSub(t9,t7,a.h,n);FSub(t7,t7,t9,n);FSub(t9,a.h,t7,n);
  FMul(t2,t7,t7,n);FMul(t1,t7,t9,n);FSub(t2,t2,t0,n);FAdd(t2,t2,t1,n);
  FMul(t11,t9,t9,n);FAdd(t2,t2,t1,n);FAdd(t2,t2,t11,n);
  FMul(t3,a.h,a.l,n);FAdd(t2,t2,t3,n);FAdd(t2,t2,t3,n);
  FAdd(d.h,t0,t2,n);FSub(t6,d.h,t0,n);FSub(d.l,t2,t6,n);
 }
 __aicore__ inline void residual(LocalTensor<float> d,LocalTensor<float> aa,LocalTensor<float> bb,LocalTensor<float> target){FMul(t0,aa,bb,n);FMuls(t7,aa,4097.0f,n);FMuls(t8,bb,4097.0f,n);FSub(t9,t7,aa,n);FSub(t10,t8,bb,n);FSub(t7,t7,t9,n);FSub(t8,t8,t10,n);FSub(t9,aa,t7,n);FSub(t10,bb,t8,n);FMul(t2,t7,t8,n);FMul(t1,t7,t10,n);FSub(t2,t2,t0,n);FMul(t11,t9,t8,n);FAdd(t2,t2,t1,n);FMul(t1,t9,t10,n);FAdd(t2,t2,t11,n);FAdd(t2,t2,t1,n);FSub(t0,target,t0,n);FSub(d,t0,t2,n);}
 // Same residual(a,a,target) term order; reuse the identical split and cross product.
 __aicore__ inline void residualSquare(LocalTensor<float> d,LocalTensor<float> a,LocalTensor<float> target){
  FMul(t0,a,a,n);FMuls(t7,a,4097.0f,n);FSub(t9,t7,a,n);FSub(t7,t7,t9,n);FSub(t9,a,t7,n);
  FMul(t2,t7,t7,n);FMul(t1,t7,t9,n);FSub(t2,t2,t0,n);FAdd(t2,t2,t1,n);
  FMul(t11,t9,t9,n);FAdd(t2,t2,t1,n);FAdd(t2,t2,t11,n);
  FSub(t0,target,t0,n);FSub(d,t0,t2,n);
 }
 // Bounded Small roots only: share the square split and accumulate split cross products.
 // Conditional exact normal-or-zero products preserve the three original FP32 additions.
 // The full square is still rounded separately; this is not a whole-product FMA.
 __aicore__ inline void residualSquareExactCross(LocalTensor<float> d,
  LocalTensor<float> a,LocalTensor<float> target){
  FMul(t0,a,a,n);FMuls(t7,a,4097.0f,n);FSub(t9,t7,a,n);
  FSub(t7,t7,t9,n);FSub(t9,a,t7,n);
  FMul(t2,t7,t7,n);FSub(t2,t2,t0,n);
  MulAddDst<float,float,false>(t2,t7,t9,(uint64_t)0,(uint8_t)1,{1,1,1,8,8,8});
  MulAddDst<float,float,false>(t2,t7,t9,(uint64_t)0,(uint8_t)1,{1,1,1,8,8,8});
  MulAddDst<float,float,false>(t2,t9,t9,(uint64_t)0,(uint8_t)1,{1,1,1,8,8,8});
  FSub(t0,target,t0,n);FSub(d,t0,t2,n);
 }
 __aicore__ inline void neg(DF d,DF a){FMuls(d.h,a.h,-1.0f,n);FMuls(d.l,a.l,-1.0f,n);}
};
#pragma clang fp reassociate(off) contract(off)
// Compensated FP32 arithmetic on the NPU; no mathematical lookup.
struct SF { float h,l; };
__aicore__ inline float SR(float v){return v;}
__aicore__ inline SF SAdd(SF a,SF b){
 float h=SR(a.h+b.h),v=SR(h-a.h);
 float t=SR(SR(a.h-SR(h-v))+SR(b.h-v));
 t=SR(t+SR(a.l+b.l));float r=SR(h+t);
 return {r,SR(t-SR(r-h))};
}
__aicore__ inline SF SMul(SF a,SF b){
 float h=SR(a.h*b.h),ca=SR(4097.0f*a.h),cb=SR(4097.0f*b.h);
 float ah=SR(ca-SR(ca-a.h)),bh=SR(cb-SR(cb-b.h));
 float al=SR(a.h-ah),bl=SR(b.h-bh);
 float t=SR(SR(ah*bh)-h);t=SR(t+SR(ah*bl));t=SR(t+SR(al*bh));t=SR(t+SR(al*bl));
 t=SR(t+SR(a.h*b.l));t=SR(t+SR(a.l*b.h));
 float r=SR(h+t);return {r,SR(t-SR(r-h))};
}
__aicore__ inline SF SDiv(SF a,SF b){
 float q=SR(a.h/b.h);SF p=SMul(b,{q,0.0f});
 SF r=SAdd(a,{-p.h,-p.l});return SAdd({q,0.0f},{SR(SR(r.h+r.l)/b.h),0.0f});
}
// Same degree19 series, with compile-time high-tail and compensated-low bounds.
template<int Cutoff> __aicore__ inline SF LogHornerTail(SF z2){
 static_assert(Cutoff==7 || Cutoff==11,"Log high-tail cutoff");
 float tail=SDiv({1.0f,0.0f},{19.0f,0.0f}).h;
 #pragma unroll
 for(int j=17;j>=Cutoff;j-=2){tail=SR(SR(tail*z2.h)+SDiv({1.0f,0.0f},{(float)j,0.0f}).h);}
 SF poly{tail,0.0f};
 #pragma unroll
 for(int j=Cutoff-2;j>=3;j-=2){poly=SAdd(SMul(poly,z2),SDiv({1.0f,0.0f},{(float)j,0.0f}));}
 return poly;
}
__aicore__ inline void LogPair(float theta,float &h,float &l){
 RopeBits b;b.f=theta;int e=(int)((b.u>>23)&255)-127;
 uint32_t mant=b.u&0x7fffff;b.u=mant|0x3f800000;float m=b.f;
 if(m>1.5f){m=SR(m*0.5f);e++;}
 SF z=SDiv(SAdd({m,0.0f},{-1.0f,0.0f}),SAdd({m,0.0f},{1.0f,0.0f}));
 // Keep the split of z.h for this invocation's square and later cubic.
 // Each compensated addition keeps the original SMul evaluation order.
 float zLead,zTrail;
 SF z2;
 {
  const float product=SR(z.h*z.h),scaled=SR(4097.0f*z.h);
  zLead=SR(scaled-SR(scaled-z.h));zTrail=SR(z.h-zLead);
  float error=SR(SR(zLead*zLead)-product);
  const float cross=SR(zLead*zTrail);
  error=SR(error+cross);error=SR(error+cross);
  error=SR(error+SR(zTrail*zTrail));
  const float mixed=SR(z.h*z.l);
  error=SR(error+mixed);error=SR(error+mixed);
  const float high=SR(product+error);
  z2={high,SR(error-SR(high-product))};
 }
 // Runtime numeric gate; all theta-dependent math remains on the NPU.
 const bool cheapTail=theta>=1.0f && theta<=0x1p32f && z.h>=-0.125f && z.h<=0.125f;
 SF poly=cheapTail?LogHornerTail<7>(z2):LogHornerTail<11>(z2);
 SF z3;
 {
  const float product=SR(z.h*z2.h),scaled=SR(4097.0f*z2.h);
  const float lead=SR(scaled-SR(scaled-z2.h)),trail=SR(z2.h-lead);
  float error=SR(SR(zLead*lead)-product);
  error=SR(error+SR(zLead*trail));error=SR(error+SR(zTrail*lead));
  error=SR(error+SR(zTrail*trail));
  error=SR(error+SR(z.h*z2.l));error=SR(error+SR(z.l*z2.h));
  const float high=SR(product+error);
  z3={high,SR(error-SR(high-product))};
 }
 SF total=SAdd(z,SMul(z3,poly));
 total={SR(total.h*2.0f),SR(SR(total.l*2.0f)+0.0f)};
 SF exponent=SMul({(float)e,0.0f},{0.693147182464599609375f,-1.904654323148236e-9f});
 total=SAdd(total,exponent);h=total.h;l=total.l;
}
// Runtime positive-theta root ladder; no stored mathematical results.
// Logical index masks select digits; every floating root is computed on device.
template<int HalfDim>
__aicore__ inline bool MakeInvPow2RootLadder(LocalTensor<float> inv,
 LocalTensor<float> w,float theta){
 static_assert(HalfDim==8 || HalfDim==16,"Short root axis must be 8 or 16");
 if(!(theta>=0x1p-32f && theta<=0x1p32f))return false;
 constexpr int n=(HalfDim+7)/8*8;
 constexpr int stages=HalfDim==8?3:4;
 // Track only the exact positive-root prefix; one failed stage disables the gate.
 bool exactPrefix=true;
 float exactRootValue=theta;
 SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(0,n);
 DF root{w,w[n]},accPow{w[2*n],w[3*n]},seed{w[4*n],w[5*n]};
 DF correction{w[6*n],w[7*n]};
 auto work=w[11*n];
 DMath dm(w[12*n],n);
 dm.set(root,theta,0.0f);dm.set(accPow,1.0f,0.0f);dm.set(seed,1.0f,0.0f);
 PipeBarrier<PIPE_V>();
 // Preserve align16 padding powers: d=8 upper lanes start at theta.
 if constexpr(n>HalfDim){
  constexpr uint64_t upperMask=((1ULL<<n)-1ULL)^((1ULL<<HalfDim)-1ULL);
  SetMaskNorm();SetVectorMask<float,MaskMode::NORMAL>(0,upperMask);
  FDuplicate(accPow.h,theta,n);PipeBarrier<PIPE_V>();
  SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(0,n);
 }
 #pragma unroll
 for(int bit=stages-1;bit>=0;bit--){
  // Same complete-lane sqrt residual and pair normalization as the parent.
  Sqrt<float,false>(seed.h,root.h,(uint64_t)0,(uint8_t)1,{1,1,8,8});
  FDuplicate(seed.l,0.0f,n);PipeBarrier<PIPE_V>();
  bool exactRoot=false;
  if(exactPrefix){
   SetFlag<HardEvent::V_S>(EVENT_ID2);WaitFlag<HardEvent::V_S>(EVENT_ID2);
   const float qValue=seed.h.GetValue(0);
   RopeBits qBits;qBits.f=qValue;
   // Twelve significant bits make the square and4097split products exact.
   // Every value and this numeric gate are computed on the NPU in this call.
   exactRoot=qValue>=0x1p-16f && qValue<=0x1p16f && (qBits.u&0xfffu)==0 && SR(qValue*qValue)==exactRootValue;
   SetFlag<HardEvent::S_V>(EVENT_ID2);WaitFlag<HardEvent::S_V>(EVENT_ID2);
   if(exactRoot)exactRootValue=qValue;
   else exactPrefix=false;
  }
  if(exactRoot){
   dm.cp(root.h,seed.h);FDuplicate(root.l,0.0f,n);
   PipeBarrier<PIPE_V>();
  }else{
  dm.residualSquareExactCross(correction.h,seed.h,root.h);
  FAdd(correction.h,correction.h,root.l,n);
  FDiv(correction.h,correction.h,seed.h,n);
  FMuls(correction.h,correction.h,0.5f,n);
  FDuplicate(correction.l,0.0f,n);
  FAdd(root.h,seed.h,correction.h,n);
  FSub(work,root.h,seed.h,n);
  FSub(root.l,root.h,work,n);
  FSub(correction.l,correction.h,work,n);
  FSub(root.l,seed.h,root.l,n);
  FAdd(root.l,root.l,correction.l,n);PipeBarrier<PIPE_V>();
  }
  // A mask bit is one exactly when that lane's frequency-index digit is one.
  // DMath's false-mask, repeat1 arithmetic is independent in every FP32 lane.
  const uint64_t logicalMask=~(~0ULL/((1ULL<<(1u<<bit))+1ULL))&((1ULL<<n)-1ULL);
  SetMaskNorm();SetVectorMask<float,MaskMode::NORMAL>(0,logicalMask);
  if(bit==stages-1){
   dm.cp(accPow.h,root.h);dm.cp(accPow.l,root.l);
   FAdds(accPow.l,accPow.l,0.0f,n);
  }else if(bit==stages-2 && exactRoot){
   // The successful prefix leaves each operand with at most 12 significant bits.
   // Their positive product is exact FP32; both old pair low components are +0.
   FMul(accPow.h,accPow.h,root.h,n);
   FDuplicate(accPow.l,0.0f,n);
  }else dm.mul(accPow,accPow,root);
  PipeBarrier<PIPE_V>();
  SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(0,n);
 }
 // The complete n lanes were initialized; masked-off accumulators stay live.
 // Preserve the parent's final positive-power rounding and reciprocal chain.
 auto power=w[10*n],scale=accPow.l,ones=w[9*n];
 FAdd(power,accPow.h,accPow.l,n);FDuplicate(ones,1.0f,n);
 FDiv(inv,ones,power,n);dm.residual(scale,inv,power,ones);
 FDiv(scale,scale,power,n);FAdd(inv,inv,scale,n);
 SetMaskNorm();ResetMask();return true;
}

template<bool Slice=false>
__aicore__ inline void MakeInvOriginal(LocalTensor<float> inv,LocalTensor<float> w,int halfDim,float theta,int indexStart=0,int laneCount=0){
 int n=((Slice?laneCount:halfDim)+15)/16*16;SetMaskCount();SetVectorMask<float,MaskMode::COUNTER>(0,n);
 DF z{w,w[n]},z2{w[2*n],w[3*n]},acc{w[4*n],w[5*n]},c{w[6*n],w[7*n]},v{w[8*n],w[9*n]},ln{w[2*n],w[3*n]},ex{w[4*n],w[5*n]},reduced{w[6*n],w[7*n]};
 auto power=w[10*n],k=w[11*n],scale=w[3*n],ones=w[9*n];
 DMath dm(w[12*n],n);
 // Issue the theta-independent ratio work before the scalar log chain.
 if((halfDim & (halfDim-1)) == 0){
 FArange(z.h,(float)(Slice?indexStart:0),1.0f,n);FMuls(z.h,z.h,1.0f/(float)halfDim,n);
